      "seed": 389940461,
      "version": 517,
      "versionNonce": 1204765411,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763813533522,
      "link": null,
      "locked": false,
      "text": "Now here in CodeEditor.java \nwe have two class \nCodeEditor(One) and then VsCode\nwhich essentially extends to CodeEditor\nso type of VsCode is also CodeEditor \nthis is upcasting as CodeEditor is \nparent class -Vscode inherits from \nit making it of same \ntype so when spring will inject\nObject of type CodeEditor spring \ncan inject any of them as both\nare same type that's why we use\n@Primary annotation to let \nknow CodeEditor has primary priority",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now here in CodeEditor.java \nwe have two class \nCodeEditor(One) and then VsCode\nwhich essentially extends to CodeEditor\nso type of VsCode is also CodeEditor \nthis is upcasting as CodeEditor is \nparent class -Vscode inherits from \nit making it of same \ntype so when spring will inject\nObject of type CodeEditor spring \ncan inject any of them as both\nare same type that's why we use\n@Primary annotation to let \nknow CodeEditor has primary priority",
      "autoResize": true,
      "lineHeight": 1.25
    },
