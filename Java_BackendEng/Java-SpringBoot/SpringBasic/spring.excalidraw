      "seed": 169798989,
      "version": 160,
      "versionNonce": 571976013,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763839974318,
      "link": null,
      "locked": false,
      "text": "we will start with how to inject primitive datatype \nproperty's value first and then we will go to non-primitive\ntype like class",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we will start with how to inject primitive datatype \nproperty's value first and then we will go to non-primitive\ntype like class",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xcYatPvOmWN6pNsYcvKzX",
      "type": "text",
      "x": 603.9812295844206,
      "y": 43566.21458442495,
      "width": 649,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bSV",
      "roundness": null,
      "seed": 833001699,
      "version": 217,
      "versionNonce": 83840611,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763840272649,
      "link": null,
      "locked": false,
      "text": "i)update the spring.xml file:\nSyntax\n<bean id=\"beanId\" class=\"ClassName\">\n    <property name=\"propertyNameInClass\" value=\"\"/>\n</bean>\n\nThis is how we inject a primitive type value in bean object\n    ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
