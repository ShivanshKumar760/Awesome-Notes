    {
      "id": "79qs-b4rPFmZ-TpW81LkG",
      "type": "text",
      "x": 652.6425291069429,
      "y": 37389.050390416574,
      "width": 418,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
