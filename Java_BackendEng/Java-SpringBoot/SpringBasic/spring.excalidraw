      "index": "bS4",
      "roundness": null,
      "seed": 1292449613,
      "version": 53,
      "versionNonce": 472654979,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763827125495,
      "link": null,
      "locked": false,
      "text": "let's understand this with an example:\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "let's understand this with an example:\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4lxTNq5vSJdwNXW8NbbZX",
      "type": "text",
      "x": 719.3161725933046,
      "y": 37459.31172911861,
      "width": 374,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bS5",
      "roundness": null,
      "seed": 1700524525,
      "version": 50,
      "versionNonce": 1617327171,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763827160146,
      "link": null,
      "locked": false,
      "text": "Student stu3=new Student();\nStudent stu4=stu3;\nStudent stu5=stu3;\n\nstu4.setAge(25);\nSystem.out.println(stu4.getAge());\nSystem.out.println(stu5.getAge());",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Student stu3=new Student();\nStudent stu4=stu3;\nStudent stu5=stu3;\n\nstu4.setAge(25);\nSystem.out.println(stu4.getAge());\nSystem.out.println(stu5.getAge());",
      "autoResize": true,
      "lineHeight": 1.25
    },
