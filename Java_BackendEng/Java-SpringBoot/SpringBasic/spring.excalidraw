    {
      "id": "4nhaF85fKz8Bd36usu-G5",
      "type": "text",
      "x": 389.43130796623086,
      "y": 29950.116422944953,
      "width": 942.8618161419197,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bRU",
