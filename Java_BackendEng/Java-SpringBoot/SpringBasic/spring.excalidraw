      "isDeleted": false,
      "boundElements": null,
      "updated": 1763828280107,
      "link": null,
      "locked": false,
      "text": "⭐In Spring, beans are Singleton by default. This means that only\none \ninstance of the bean is created and shared across the entire\napplication context.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⭐In Spring, beans are Singleton by default. This means that only one \ninstance of the bean is created and shared across the entire application context.",
      "autoResize": false,
      "lineHeight": 1.25
    },
