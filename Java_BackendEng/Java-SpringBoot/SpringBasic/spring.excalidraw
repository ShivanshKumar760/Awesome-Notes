    {
      "id": "wi9GpO_CSKVshK3v4Ah4z",
      "type": "text",
      "x": 387.5971131236398,
      "y": 14045.132194134101,
      "width": 726,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bQF",
      "roundness": null,
      "seed": 1460135299,
      "version": 47,
      "versionNonce": 2038680237,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763811190852,
      "link": null,
      "locked": false,
      "text": "Spring Boot auto-scans components because @SpringBootApplication\nalready contains @ComponentScan. You need to define @ComponentScan\nmanually only if your beans are outside the main package.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Spring Boot auto-scans components because @SpringBootApplication already contains @ComponentScan. You need to define @ComponentScan manually only if your beans are outside the main package.",
      "autoResize": false,
      "lineHeight": 1.25
    },
