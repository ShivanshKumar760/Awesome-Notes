      "text": "✔ Easy packaging\n\nJust run:\n\njava -jar app.jar\n\n\nNo WAR files.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "✔ Easy packaging\n\nJust run:\n\njava -jar app.jar\n\n\nNo WAR files.",
