      "isDeleted": false,
      "boundElements": null,
      "updated": 1763811141507,
      "link": null,
      "locked": false,
      "text": "Now for spring to know which class need to be managed by spring that \nis bean object and which class needs to be managed by us programmer\nwe need to specify class with some special annotation so that spring\nknows that we need to map this class into our application context",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now for spring to know which class need to be managed by spring that \nis bean object and which class needs to be managed by us programmer\nwe need to specify class with some special annotation so that spring\nknows that we need to map this class into our application context",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iXPMiwHrHpKFAO9Sc7SFM",
      "type": "text",
      "x": 422.74667577010587,
      "y": 13533.685489786822,
      "width": 704,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
