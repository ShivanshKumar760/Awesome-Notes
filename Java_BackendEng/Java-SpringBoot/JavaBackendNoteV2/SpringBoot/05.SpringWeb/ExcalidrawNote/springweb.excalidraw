    {
      "id": "kD8ARsJ-HS9ii_YIR_R71",
      "type": "text",
      "x": -84.4640216465732,
      "y": 44156.80282042695,
      "width": 352,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bbN",
      "roundness": null,
      "seed": 1850558322,
      "version": 42,
      "versionNonce": 157603054,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764401032940,
      "link": null,
      "locked": false,
      "text": "🧠 But then why use it?\nSpring Boot gives you 2 options:",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🧠 But then why use it?\nSpring Boot gives you 2 options:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IJx6traSdAqXBRtMl3ktG",
      "type": "text",
      "x": -89.53217752732559,
      "y": 44234.523675318,
      "width": 715,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bbO",
      "roundness": null,
      "seed": 1397335154,
      "version": 44,
      "versionNonce": 1663091822,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764401045692,
      "link": null,
      "locked": false,
      "text": "🔹 Option 1 — Modern Approach (Recommended)\n\nUse Spring-style request mapping:\n\n@GetMapping(\"/add\")\npublic String add(@RequestParam int num1, @RequestParam int num2)\n{\n    int result = num1 + num2;\n    System.out.println(result);\n    return \"result.jsp\";\n}\n\n\n✔ Clear\n✔ Cleaner\n✔ Type-checked\n✔ No manual parsing",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🔹 Option 1 — Modern Approach (Recommended)\n\nUse Spring-style request mapping:\n\n@GetMapping(\"/add\")\npublic String add(@RequestParam int num1, @RequestParam int num2) {\n    int result = num1 + num2;\n    System.out.println(result);\n    return \"result.jsp\";\n}\n\n\n✔ Clear\n✔ Cleaner\n✔ Type-checked\n✔ No manual parsing",
      "autoResize": false,
      "lineHeight": 1.25
    },
