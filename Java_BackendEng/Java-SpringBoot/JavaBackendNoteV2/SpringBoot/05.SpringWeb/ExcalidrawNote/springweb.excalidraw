    {
      "id": "KsamUjoCg7RIBW22YAcUz",
      "type": "text",
      "x": 141.13897061520237,
      "y": 38451.38701243131,
      "width": 698.4609375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bae",
      "roundness": null,
      "seed": 1726594798,
      "version": 110,
      "versionNonce": 34254258,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764399179771,
      "link": null,
      "locked": false,
      "text": "🔥 6. JSP converts to Servlet because:\n✔ JSP needs to send HTML back to the client\n✔ HTML must be wrapped in a Servlet to be sent through Servlet\nOutputStream\n✔ Tomcat's request pipeline requires Servlet classes\n✔ JSP tags (<%= %>) must become Java code to run",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🔥 6. JSP converts to Servlet because:\n✔ JSP needs to send HTML back to the client\n✔ HTML must be wrapped in a Servlet to be sent through Servlet OutputStream\n✔ Tomcat's request pipeline requires Servlet classes\n✔ JSP tags (<%= %>) must become Java code to run",
      "autoResize": false,
      "lineHeight": 1.25
    },
