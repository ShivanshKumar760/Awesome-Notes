    {
      "id": "_D4Z2xJdovABHVDo0tsms",
      "type": "text",
      "x": -165.2737625397683,
      "y": 64386.322778542795,
      "width": 539,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcp",
      "roundness": null,
      "seed": 31143982,
      "version": 41,
      "versionNonce": 1513605938,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764404495123,
      "link": null,
      "locked": false,
      "text": "🟩 7. Final Crystal-Clear Summary\n⭐ Model.addAttribute()\n\n-Only to pass data to JSP/HTML ONE TIME\n\n-Works only for current request\n\n-Internally uses request scope\n\n⭐ request.setAttribute()\n\n-Same scope as Model\n\n-Raw servlet version\n\n⭐ session.setAttribute()\n\n-Store data for whole session\n\n-For login state, shopping cart, user preferences",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🟩 7. Final Crystal-Clear Summary\n⭐ Model.addAttribute()\n\n-Only to pass data to JSP/HTML ONE TIME\n\n-Works only for current request\n\n-Internally uses request scope\n\n⭐ request.setAttribute()\n\n-Same scope as Model\n\n-Raw servlet version\n\n⭐ session.setAttribute()\n\n-Store data for whole session\n\n-For login state, shopping cart, user preferences",
      "autoResize": true,
      "lineHeight": 1.25
    },
