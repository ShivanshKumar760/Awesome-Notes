      "text": "@Controller\npublic class HomeController {\n\n    @GetMapping(\"/hello\")\n    public String hello(Model model) {\n        model.addAttribute(\"msg\", \"Hello MVC\");\n        return \"hello.jsp\";\n    }\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "@Controller\npublic class HomeController {\n\n    @GetMapping(\"/hello\")\n    public String hello(Model model) {\n        model.addAttribute(\"msg\", \"Hello MVC\");\n        return \"hello.jsp\";\n    }\n}",
