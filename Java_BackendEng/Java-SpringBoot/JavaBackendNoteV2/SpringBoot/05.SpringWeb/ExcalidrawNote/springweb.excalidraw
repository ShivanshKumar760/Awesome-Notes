      "seed": 1285574766,
      "version": 45,
      "versionNonce": 1894584946,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764400846009,
      "link": null,
      "locked": false,
      "text": "@RequestMapping(\"add\") \npublic String add(HttpServletRequest req) { \nint num1 = Integer.parseInt(req.getParameter(\"num1\")); \nint num2 = Integer.parseInt(req.getParameter(\"num2\")); \nint result = num1 + num2; \nSystem.out.println(result); \nreturn \"result.jsp\"; \n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "@RequestMapping(\"add\") \npublic String add(HttpServletRequest req) { \nint num1 = Integer.parseInt(req.getParameter(\"num1\")); \nint num2 = Integer.parseInt(req.getParameter(\"num2\")); \nint result = num1 + num2; \nSystem.out.println(result); \nreturn \"result.jsp\"; \n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
