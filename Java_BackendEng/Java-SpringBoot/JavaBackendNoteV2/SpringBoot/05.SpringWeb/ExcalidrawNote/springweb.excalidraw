    {
      "id": "Eykc3v3BJ1HXZ0SW17bVM",
      "type": "text",
      "x": -132.28960317525616,
      "y": 61597.431451534976,
      "width": 698.4609375,
      "height": 825,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcg",
      "roundness": null,
      "seed": 1687186094,
      "version": 62,
      "versionNonce": 1885810222,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764404379095,
      "link": null,
      "locked": false,
      "text": "🟦 5. Example to Understand This Clearly\n⭐ CASE 1: Show data only once → Use Model or request attribute\n\nController:\n\nmodel.addAttribute(\"msg\", \"Welcome Shiv\");\nreturn \"home.jsp\";\n\n\nServlet:\n\nrequest.setAttribute(\"msg\", \"Welcome Shiv\");\n\n\nBoth disappear after one render.\n\n⭐ CASE 2: Keep user logged in → Use session.setAttribute()\n\nServlet:\n\nHttpSession session = req.getSession();\nsession.setAttribute(\"user\", userObject);\n\n\nNow the user stays logged in across:\n\n/dashboard\n\n/profile\n\n/orders\n\n/settings",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🟦 5. Example to Understand This Clearly\n⭐ CASE 1: Show data only once → Use Model or request attribute\n\nController:\n\nmodel.addAttribute(\"msg\", \"Welcome Shiv\");\nreturn \"home.jsp\";\n\n\nServlet:\n\nrequest.setAttribute(\"msg\", \"Welcome Shiv\");\n\n\nBoth disappear after one render.\n\n⭐ CASE 2: Keep user logged in → Use session.setAttribute()\n\nServlet:\n\nHttpSession session = req.getSession();\nsession.setAttribute(\"user\", userObject);\n\n\nNow the user stays logged in across:\n\n/dashboard\n\n/profile\n\n/orders\n\n/settings",
      "autoResize": true,
      "lineHeight": 1.25
    },
