    {
      "id": "dWqc0VOKkcPGhMPbIG_6v",
      "type": "text",
      "x": 475.7836280565896,
      "y": 4307.258860037526,
      "width": 682,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
