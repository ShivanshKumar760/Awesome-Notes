    {
      "id": "jrs_qBLeCfTVsgpjjxkci",
      "type": "text",
      "x": -136.1591230267801,
      "y": 60073.84701756344,
      "width": 522.4609375,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcd",
      "roundness": null,
      "seed": 612281774,
      "version": 59,
      "versionNonce": 320045678,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764404343596,
      "link": null,
      "locked": false,
      "text": "🟥 3. setAttribute() can be used on TWO objects\nA. Request Scope:\nreq.setAttribute(\"name\", \"Shiv\");\n\n\nSame behavior as Spring's Model.\n\nB. Session Scope:\nsession.setAttribute(\"user\", userObject);\n\n\nThis stays as long as:\n\n✔ Browser is open\n✔ Session timeout not reached\n✔ User does not log out\n\nSo:\n\n🚨 Model ≠ session.setAttribute()\n\nThey are completely different things.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🟥 3. setAttribute() can be used on TWO objects\nA. Request Scope:\nreq.setAttribute(\"name\", \"Shiv\");\n\n\nSame behavior as Spring's Model.\n\nB. Session Scope:\nsession.setAttribute(\"user\", userObject);\n\n\nThis stays as long as:\n\n✔ Browser is open\n✔ Session timeout not reached\n✔ User does not log out\n\nSo:\n\n🚨 Model ≠ session.setAttribute()\n\nThey are completely different things.",
      "autoResize": true,
      "lineHeight": 1.25
    },
