    {
      "id": "F9S_svxAxCEleVo0526f3",
      "type": "text",
      "x": 458.47356660353466,
      "y": 6311.017119203141,
      "width": 700.6504521543939,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bXw",
      "roundness": null,
      "seed": 1889201778,
      "version": 106,
      "versionNonce": 1502909678,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764350077876,
      "link": null,
      "locked": false,
      "text": "🔥 Example: Spring Boot Web MVC Flow\n\nController\n\n@Controller\npublic class StudentController {\n\n    @GetMapping(\"/student\")\n    public String showStudent(Model model) {\n        Student s = new Student(1, \"Shiv\", 21);\n        model.addAttribute(\"stu\", s);\n        return \"student.jsp\";\n    }\n}\n\nstudent.jsp\n<h1>Student: ${stu.name}</h1>\n\nResult\n\nStudent: Shiv",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🔥 Example: Spring Boot Web MVC Flow\n\nController\n\n@Controller\npublic class StudentController {\n\n    @GetMapping(\"/student\")\n    public String showStudent(Model model) {\n        Student s = new Student(1, \"Shiv\", 21);\n        model.addAttribute(\"stu\", s);\n        return \"student.jsp\";\n    }\n}\n\nstudent.jsp\n<h1>Student: ${stu.name}</h1>\n\nResult\n\nStudent: Shiv",
      "autoResize": false,
      "lineHeight": 1.25
    },
