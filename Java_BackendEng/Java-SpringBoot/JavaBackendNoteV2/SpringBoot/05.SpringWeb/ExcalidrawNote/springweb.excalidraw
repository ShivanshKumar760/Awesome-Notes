    {
      "id": "SFqelzHqlo6wVRKFnpEoR",
      "type": "text",
      "x": 112.92200028629009,
      "y": 40421.31136498073,
      "width": 506,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
