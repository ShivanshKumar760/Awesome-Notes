    {
      "id": "-V7u01nun5lQ0NfPIowB7",
      "type": "text",
      "x": -100.29562723541414,
      "y": 44719.834118162944,
      "width": 638,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bbR",
      "roundness": null,
      "seed": 544810930,
      "version": 67,
      "versionNonce": 373688878,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764401116992,
      "link": null,
      "locked": false,
      "text": "🔹 Option 2 — Old-school Servlet style (Still allowed)\n\n\n @GetMapping(\"/add\")\n public String add(HttpServletRequest req) {\n    int num1 = Integer.parseInt(req.getParameter(\"num1\"));\n    int num2 = Integer.parseInt(req.getParameter(\"num2\"));\n    int result = num1 + num2;\n    return \"result.jsp\";\n }\n\n\n✔ Works because DispatcherServlet still passes a\nHttpServletRequest\n✔ For backwards compatibility\n✔ Useful for advanced low-level needs",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🔹 Option 2 — Old-school Servlet style (Still allowed)\n\n\n @GetMapping(\"/add\")\n public String add(HttpServletRequest req) {\n    int num1 = Integer.parseInt(req.getParameter(\"num1\"));\n    int num2 = Integer.parseInt(req.getParameter(\"num2\"));\n    int result = num1 + num2;\n    return \"result.jsp\";\n }\n\n\n✔ Works because DispatcherServlet still passes a HttpServletRequest\n✔ For backwards compatibility\n✔ Useful for advanced low-level needs",
      "autoResize": false,
      "lineHeight": 1.25
    },
