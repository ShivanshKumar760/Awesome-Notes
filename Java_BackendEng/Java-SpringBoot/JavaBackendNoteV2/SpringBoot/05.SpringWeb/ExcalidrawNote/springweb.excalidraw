    {
      "id": "Sd0Y-nAuq6rbq746dVQf2",
      "type": "text",
      "x": -408.51578409345825,
      "y": 81095.71158476293,
      "width": 715,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
