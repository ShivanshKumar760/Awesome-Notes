      "seed": 1471987630,
      "version": 26,
      "versionNonce": 936360306,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764400515559,
      "link": null,
      "locked": false,
      "text": "1. We need a form. (index.jsp)\n \n<%@page language=\"java\" %> \n<html> \n<body> \n<h2>Telusko Calculator</h2> \n<form action=\"add\"> \n<label for=\"num1\">Enter 1st Number :</label> \n<input type=\"text\" id=\"num1\" name=\"num1\"><br> \n<label for=\"num2\">Enter 2nd Number :</label> \n</form> \n</body> \n<input type=\"text\" id=\"num2\" name=\"num2\"><br> \n<input type=\"submit\" value=\"Submit\"> \n</html>",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. We need a form. (index.jsp)\n \n<%@page language=\"java\" %> \n<html> \n<body> \n<h2>Telusko Calculator</h2> \n<form action=\"add\"> \n<label for=\"num1\">Enter 1st Number :</label> \n<input type=\"text\" id=\"num1\" name=\"num1\"><br> \n<label for=\"num2\">Enter 2nd Number :</label> \n</form> \n</body> \n<input type=\"text\" id=\"num2\" name=\"num2\"><br> \n<input type=\"submit\" value=\"Submit\"> \n</html>",
      "autoResize": true,
      "lineHeight": 1.25
    },
