    {
      "id": "jXBLLjDBmpVoaPNbHvksd",
      "type": "text",
      "x": 191.20348987279812,
      "y": 34053.49861214503,
      "width": 709.4609375,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "baE",
