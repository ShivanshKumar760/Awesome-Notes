    },
    {
      "id": "KwxoPuQD6kS0RyDh22r0C",
      "type": "text",
      "x": 231.70115677328545,
      "y": 28803.543585357922,
      "width": 687.4609375,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bZw",
