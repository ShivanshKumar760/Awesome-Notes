      "containerId": null,
      "originalText": "Now the thing is that by default form \nmethod is post and here in form action \nwe have (add)-->as the url endpoint\nmeaning we need a controller mapped to \n/add endpoint",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "urHyu-r5t3Sp2DY5hdWBd",
      "type": "text",
      "x": -58.54571606811095,
      "y": 41731.089301368986,
      "width": 814,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
