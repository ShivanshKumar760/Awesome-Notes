    {
      "id": "lzpIqDapydjx_GHPmJVIJ",
      "type": "text",
      "x": -52.862664573286,
      "y": 42418.15890053093,
      "width": 605,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
