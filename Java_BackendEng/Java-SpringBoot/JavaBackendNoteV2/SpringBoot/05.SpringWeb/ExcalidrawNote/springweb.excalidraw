      "boundElements": null,
      "updated": 1764401546338,
      "link": null,
      "locked": false,
      "text": "🔵 3. Use RequestContextHolder (Advanced use only)\n\nUsed when you need the request outside a controller, e.g., in\nservice layer:\n\nHttpServletRequest req =\n   ((ServletRequestAttributes)\nRequestContextHolder.getRequestAttributes())\n   .getRequest();",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🔵 3. Use RequestContextHolder (Advanced use only)\n\nUsed when you need the request outside a controller, e.g., in service layer:\n\nHttpServletRequest req =\n   ((ServletRequestAttributes) RequestContextHolder.getRequestAttributes())\n   .getRequest();",
      "autoResize": false,
      "lineHeight": 1.25
    },
