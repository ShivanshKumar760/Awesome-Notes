      "updated": 1764400656269,
      "link": null,
      "locked": false,
      "text": "Now the thing is that by default form \nmethod is post and here in form action \nwe have (add)-->as the url endpoint\nmeaning we need a controller mapped to \n/add endpoint",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
