    {
      "id": "WI1Tw_fzpU6rXOwHhsgHV",
      "type": "text",
      "x": 227.71119952441757,
      "y": 29852.76571158273,
      "width": 660,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
