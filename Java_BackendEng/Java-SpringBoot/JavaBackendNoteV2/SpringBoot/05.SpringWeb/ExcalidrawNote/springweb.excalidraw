    {
      "id": "Xg606x1rzAOHVHOAhY0yk",
      "type": "text",
      "x": 196.7880308464221,
      "y": 30519.31740174684,
      "width": 418.58458289834266,
      "height": 328.04434396421857,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
