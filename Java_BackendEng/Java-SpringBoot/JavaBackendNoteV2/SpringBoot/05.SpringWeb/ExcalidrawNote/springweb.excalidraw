    {
      "id": "AfjC_Hn_AMnRtPqzwt7_U",
      "type": "text",
      "x": 148.2495262064616,
      "y": 35598.07543351817,
      "width": 599.4609375,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "baJ",
      "roundness": null,
      "seed": 707508210,
      "version": 76,
      "versionNonce": 689717486,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764398995084,
      "link": null,
      "locked": false,
      "text": "🟨 2. JSP = HTML + a little Java for displaying data\n\nJSP was created to solve one problem:\n\n✔ Make it easy to write HTML pages\n✔ Avoid writing HTML inside Java println() statements\n✔ Allow adding Java expressions inside HTML\n\nExample JSP:\n\n<h1>Hello <%= name %></h1>\n\n\nThis is waaaay easier than writing it in a Servlet.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🟨 2. JSP = HTML + a little Java for displaying data\n\nJSP was created to solve one problem:\n\n✔ Make it easy to write HTML pages\n✔ Avoid writing HTML inside Java println() statements\n✔ Allow adding Java expressions inside HTML\n\nExample JSP:\n\n<h1>Hello <%= name %></h1>\n\n\nThis is waaaay easier than writing it in a Servlet.",
      "autoResize": true,
      "lineHeight": 1.25
    },
