      "seed": 666237294,
      "version": 73,
      "versionNonce": 1816484914,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764395789071,
      "link": null,
      "locked": false,
      "text": "🟧 7. JSP Lifecycle\nJSP File (.jsp)\n    ↓ (Tomcat reads file)\nConverted into .java servlet\n    ↓ (compiled)\nConverted into .class servlet\n    ↓\nServlet runs → generates HTML\n    ↓\nBrowser receives HTML",
      "fontSize": 26.243547517137472,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🟧 7. JSP Lifecycle\nJSP File (.jsp)\n    ↓ (Tomcat reads file)\nConverted into .java servlet\n    ↓ (compiled)\nConverted into .class servlet\n    ↓\nServlet runs → generates HTML\n    ↓\nBrowser receives HTML",
      "autoResize": true,
      "lineHeight": 1.25
    },
