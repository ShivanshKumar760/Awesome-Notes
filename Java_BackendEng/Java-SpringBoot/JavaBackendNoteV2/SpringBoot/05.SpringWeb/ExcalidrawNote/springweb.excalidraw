      "updated": 1764431306154,
      "link": null,
      "locked": false,
      "text": "🟦 B) @ModelAttribute for Adding Common Data to All JSPs\n\nExample:\n\n    @ModelAttribute\n    public void commonData(Model model) {\n        model.addAttribute(\"appName\", \"My Spring App\");\n    }\n\n\nNow every JSP can use:\n\n${appName}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🟦 B) @ModelAttribute for Adding Common Data to All JSPs\n\nExample:\n\n    @ModelAttribute\n    public void commonData(Model model) {\n        model.addAttribute(\"appName\", \"My Spring App\");\n    }\n\n\nNow every JSP can use:\n\n${appName}",
      "autoResize": true,
      "lineHeight": 1.25
    },
