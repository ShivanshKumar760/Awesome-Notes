    {
      "id": "RJLuJIRICZAA1r4RnA2QP",
      "type": "text",
      "x": -115.37755159381777,
      "y": 57145.520007985455,
      "width": 660,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
