    {
      "id": "d1PmBsJpE6-JCyqKQIqmb",
      "type": "text",
      "x": -118.20394367357812,
      "y": 58240.36232026927,
      "width": 632.4609375,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcW",
      "roundness": null,
      "seed": 1491398446,
      "version": 44,
      "versionNonce": 465464818,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764404269830,
      "link": null,
      "locked": false,
      "text": "You learned:\n\nrequest.setAttribute() → for sending data to JSP\n\nsession.setAttribute() → also exists\n\nModel in Spring is like request attributes\n\nSo the big question is:\n\n❓ If Model = request attributes, then why do we also use\nsession.setAttribute()?\n\nLet’s break this down step-by-step.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You learned:\n\nrequest.setAttribute() → for sending data to JSP\n\nsession.setAttribute() → also exists\n\nModel in Spring is like request attributes\n\nSo the big question is:\n\n❓ If Model = request attributes, then why do we also use session.setAttribute()?\n\nLet’s break this down step-by-step.",
      "autoResize": false,
      "lineHeight": 1.25
    },
