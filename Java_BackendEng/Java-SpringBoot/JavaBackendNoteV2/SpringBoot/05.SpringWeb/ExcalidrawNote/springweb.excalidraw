      "updated": 1764350572099,
      "link": null,
      "locked": false,
      "text": "✅ 3. How They Work Together\n\nDatabase Model (Entity) → loaded by Service → given to Controller → added as MVC Model → shown\non JSP.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "✅ 3. How They Work Together\n\nDatabase Model (Entity) → loaded by Service → given to Controller → added as MVC Model → shown on JSP.",
      "autoResize": false,
      "lineHeight": 1.25
    },
