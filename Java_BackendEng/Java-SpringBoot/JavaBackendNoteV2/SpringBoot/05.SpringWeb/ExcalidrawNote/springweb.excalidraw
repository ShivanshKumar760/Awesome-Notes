    {
      "id": "u6FLieiLbod2noueMheZc",
      "type": "text",
      "x": -121.38229663256709,
      "y": 48904.48641089154,
      "width": 726,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
