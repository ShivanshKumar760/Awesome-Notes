    {
      "id": "SYl0CK1PNZXulBTPfZqd8",
      "type": "text",
      "x": 149.02491274724474,
      "y": 37534.69381139118,
      "width": 693,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
