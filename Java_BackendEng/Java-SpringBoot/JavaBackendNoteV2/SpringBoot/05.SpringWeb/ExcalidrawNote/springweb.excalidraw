    {
      "id": "q4Sb2VvA5YhcjffbErMBg",
      "type": "text",
      "x": -270.50236176144216,
      "y": 68814.2109546052,
      "width": 858,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bdU",
      "roundness": null,
      "seed": 830503858,
      "version": 777,
      "versionNonce": 1135279154,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764419586423,
      "link": null,
      "locked": false,
      "text": "Nice now one thing that we are doing again and again which makes our \nwork monotonous is that every time we are returning a view technology \nfrom the controller we are mentioning .jsp file extension now the problem \nwith this is suppose after some time we decided to change our view technology\nto thymeleaf we will have to modify that extension in every controller \nwhich is not very efficient \n\n\nor suppose we need to change our view folder from webapp to webapp/views now \nby default tomcat will look into webapp but it wont look into subfolder so \nwe need to over come these problem,the way we can over come is by setting the \nprefix and suffix",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nice now one thing that we are doing again and again which makes our \nwork monotonous is that every time we are returning a view technology \nfrom the controller we are mentioning .jsp file extension now the problem \nwith this is suppose after some time we decided to change our view technology\nto thymeleaf we will have to modify that extension in every controller \nwhich is not very efficient \n\n\nor suppose we need to change our view folder from webapp to webapp/views now \nby default tomcat will look into webapp but it wont look into subfolder so \nwe need to over come these problem,the way we can over come is by setting the \nprefix and suffix",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hCQDQlh1G4Ny0tJH2hq22",
      "type": "text",
      "x": -292.20465171831177,
      "y": 69157.85546705805,
      "width": 865.0424609562353,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bdV",
      "roundness": null,
      "seed": 765546866,
      "version": 102,
      "versionNonce": 1494854958,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764419613903,
      "link": null,
      "locked": false,
      "text": "View Resolver: \n● Defines how Spring locates view files using prefix (/views/) and suffix \n(.jsp). \n\nNow we have viewresolver  to resolve and identify where the views file is and\nwith which name it is associated.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "View Resolver: \n● Defines how Spring locates view files using prefix (/views/) and suffix \n(.jsp). \n\nNow we have viewresolver  to resolve and identify where the views file is and with which name it is associated.",
      "autoResize": false,
      "lineHeight": 1.25
    },
