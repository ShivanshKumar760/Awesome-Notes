    {
      "id": "ZWi0AcS8haNRazxyFGCeS",
      "type": "text",
      "x": -310.68890378991114,
      "y": 73725.41910351397,
      "width": 924,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
