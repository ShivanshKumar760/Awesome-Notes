    {
      "id": "luNDvrPgQSnqgdDARNSOR",
      "type": "text",
      "x": -143.8975712279015,
      "y": 54243.86342520735,
      "width": 847,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bc3",
