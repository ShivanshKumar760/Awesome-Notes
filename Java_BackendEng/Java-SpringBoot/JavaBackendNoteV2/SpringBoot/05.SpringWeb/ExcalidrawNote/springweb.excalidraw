    {
      "id": "xErh8wUvfFSWL6vy_7i6Q",
      "type": "text",
      "x": -70.7192503938121,
      "y": 45465.4347790985,
      "width": 654.4609375,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
