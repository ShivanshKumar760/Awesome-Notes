    {
      "id": "ZRX7pGgeR1NH8YUJ-vRsh",
      "type": "text",
      "x": -108.43547795325264,
      "y": 50965.81809807857,
      "width": 997.9784979645797,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
