    {
      "id": "c-FnzGVZ1t-cBE90rIAlN",
      "type": "text",
      "x": -151.03686561900844,
      "y": 52046.15651373688,
      "width": 528,
      "height": 725,
      "angle": 0,
      "strokeColor": "#1e1e1e",
