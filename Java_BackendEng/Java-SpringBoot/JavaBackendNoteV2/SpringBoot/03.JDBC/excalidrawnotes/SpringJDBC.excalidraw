    {
      "id": "Aw7e-KSQ_wfucHAG56iYf",
      "type": "text",
      "x": 644.7657867320886,
      "y": 34190.504384319815,
      "width": 781,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIx",
      "roundness": null,
      "seed": 1352275950,
      "version": 42,
      "versionNonce": 1017129710,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764004636442,
      "link": null,
      "locked": false,
      "text": "🧠 RowMapper is used once per row\n\nIf query returns 3 rows, Spring calls:\n\nmapRow(row1)\nmapRow(row2)\nmapRow(row3)\n\n\nSo RowMapper is NOT recursive — it is called by Spring inside a loop.\n\n🛠️ Example: Custom RowMapper\npublic class StudentRowMapper implements RowMapper<Student> {\n\n    @Override\n    public Student mapRow(ResultSet rs, int rowNum) throws SQLException\n{\n        return new Student(\n            rs.getInt(\"id\"),\n            rs.getString(\"name\"),\n            rs.getInt(\"age\")\n        );\n    }\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🧠 RowMapper is used once per row\n\nIf query returns 3 rows, Spring calls:\n\nmapRow(row1)\nmapRow(row2)\nmapRow(row3)\n\n\nSo RowMapper is NOT recursive — it is called by Spring inside a loop.\n\n🛠️ Example: Custom RowMapper\npublic class StudentRowMapper implements RowMapper<Student> {\n\n    @Override\n    public Student mapRow(ResultSet rs, int rowNum) throws SQLException {\n        return new Student(\n            rs.getInt(\"id\"),\n            rs.getString(\"name\"),\n            rs.getInt(\"age\")\n        );\n    }\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
