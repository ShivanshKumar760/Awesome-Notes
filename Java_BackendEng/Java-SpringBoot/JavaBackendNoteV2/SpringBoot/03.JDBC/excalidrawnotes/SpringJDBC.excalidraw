    {
      "id": "6TsxBz80imfuZ5W1_DbEt",
      "type": "text",
      "x": 671.6835241123903,
      "y": 32168.72266176532,
      "width": 396,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
