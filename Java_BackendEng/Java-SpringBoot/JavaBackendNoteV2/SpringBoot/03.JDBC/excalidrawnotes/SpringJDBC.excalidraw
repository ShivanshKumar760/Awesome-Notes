    {
      "id": "-qkcLUdQBc4iXcsnNH9cL",
      "type": "text",
      "x": 677.8257182742694,
      "y": 21341.452213421348,
      "width": 660,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHS",
      "roundness": null,
      "seed": 388947342,
      "version": 55,
      "versionNonce": 1804738126,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763998370469,
      "link": null,
      "locked": false,
      "text": "⭐ How Spring Boot Chooses H2 Automatically?\nSpring Boot’s order of preference:\n\nIf H2 dependency exists → use H2\n\nIf PostgreSQL/MySQL driver present → use them\n\nIf multiple drivers → use the one matching DB URL\n\nSo if your project only has H2:\n\n✔ H2 becomes the default database\n✔ No manual configuration needed\n\n⭐ Modes of H2\nMode             Meaning\nIn-memory        Lives in RAM (testdb disappears on restart)\nFile-based       Saves DB in a .mv.db file\nServer mode      Can connect remotely\n\nExample of file mode:\n\nspring.datasource.url=jdbc:h2:file:~/mydb",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⭐ How Spring Boot Chooses H2 Automatically?\nSpring Boot’s order of preference:\n\nIf H2 dependency exists → use H2\n\nIf PostgreSQL/MySQL driver present → use them\n\nIf multiple drivers → use the one matching DB URL\n\nSo if your project only has H2:\n\n✔ H2 becomes the default database\n✔ No manual configuration needed\n\n⭐ Modes of H2\nMode             Meaning\nIn-memory        Lives in RAM (testdb disappears on restart)\nFile-based       Saves DB in a .mv.db file\nServer mode      Can connect remotely\n\nExample of file mode:\n\nspring.datasource.url=jdbc:h2:file:~/mydb",
      "autoResize": true,
      "lineHeight": 1.25
    },
