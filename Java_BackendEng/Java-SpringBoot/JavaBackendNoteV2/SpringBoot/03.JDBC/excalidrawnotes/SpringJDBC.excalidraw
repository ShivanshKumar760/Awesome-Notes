    {
      "id": "bsJFA4DIRLosUarojz0Yv",
      "type": "text",
      "x": 572.5959543450415,
      "y": 7065.711382535615,
      "width": 748,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
