    {
      "id": "29tGDQ7wDyT5_b07J1pCu",
      "type": "text",
      "x": 662.3260612931981,
      "y": 16337.908469124191,
      "width": 495,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH2",
