    {
      "id": "jozJMPQPQdayCDEgFX5OG",
      "type": "text",
      "x": 615.2005933358328,
      "y": 11853.959122572245,
      "width": 554.399658203125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGp",
