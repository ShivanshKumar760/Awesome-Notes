      "link": null,
      "locked": false,
      "text": "5. Boilerplate Code\nJDBC\n\n100+ lines of repeated code for connection, ps, rs, close blocks.\n\nSpring JDBC\n\n1–2 lines for the same task.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5. Boilerplate Code\nJDBC\n\n100+ lines of repeated code for connection, ps, rs, close blocks.\n\nSpring JDBC\n\n1–2 lines for the same task.",
      "autoResize": true,
      "lineHeight": 1.25
    },
