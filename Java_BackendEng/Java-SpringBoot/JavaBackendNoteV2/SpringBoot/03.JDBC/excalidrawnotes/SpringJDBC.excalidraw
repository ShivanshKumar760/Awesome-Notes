      "isDeleted": false,
      "boundElements": [],
      "updated": 1763993235924,
      "link": null,
      "locked": false,
      "text": "4. SQL Execution\nJDBC\n\nYou must write:\n\nPreparedStatement ps = con.prepareStatement(sql);\nResultSet rs = ps.executeQuery();\n\n\n\nSpring JDBC\n\nYou write:\n\njdbcTemplate.query(sql, rowMapper);\n\n\nAnd Spring handles:\n\nPrepareStatement\n\nResultSet loop\n\nClosing resources\n\nException translation",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. SQL Execution\nJDBC\n\nYou must write:\n\nPreparedStatement ps = con.prepareStatement(sql);\nResultSet rs = ps.executeQuery();\n\n\n\nSpring JDBC\n\nYou write:\n\njdbcTemplate.query(sql, rowMapper);\n\n\nAnd Spring handles:\n\nPrepareStatement\n\nResultSet loop\n\nClosing resources\n\nException translation",
      "autoResize": true,
      "lineHeight": 1.25
    },
