    {
      "id": "sVxHmTF5Zi5Q08apSt0yV",
      "type": "text",
      "x": 652.6309973056188,
      "y": 51620.7813002438,
      "width": 702.500413096532,
      "height": 1175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKF",
      "roundness": null,
      "seed": 57213934,
      "version": 91,
      "versionNonce": 2132973170,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764006497438,
      "link": null,
      "locked": false,
      "text": "⚙️ 3. Service Layer\n\n📍 Files:\nStudentService.java\n\n📍 Job:\n\n1.Implements business logic\n\n2.Converts DTO → Entity\n\n3.Calls repository\n\n4.Converts Entity → Response DTO\n\n📍 Examples of logic:\n\n1.Age must be > 0\n\n2.Name must not be empty\n\n4.Prevent duplicates\n\n5.Handle transaction flow\n\n🗄️ 4. Repository Layer\n\n📍 Files:\nStudentRepository.java\n\n📍 Job:\n\n1.Talks to DB\n\n2.Executes SQL (Spring JDBC)\n\n3.Uses RowMapper\n\n4.Returns Entity objects\n\n📍 Does NOT:\n\nValidate data\n\nHandle DTOs\n\nContain business logic",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⚙️ 3. Service Layer\n\n📍 Files:\nStudentService.java\n\n📍 Job:\n\n1.Implements business logic\n\n2.Converts DTO → Entity\n\n3.Calls repository\n\n4.Converts Entity → Response DTO\n\n📍 Examples of logic:\n\n1.Age must be > 0\n\n2.Name must not be empty\n\n4.Prevent duplicates\n\n5.Handle transaction flow\n\n🗄️ 4. Repository Layer\n\n📍 Files:\nStudentRepository.java\n\n📍 Job:\n\n1.Talks to DB\n\n2.Executes SQL (Spring JDBC)\n\n3.Uses RowMapper\n\n4.Returns Entity objects\n\n📍 Does NOT:\n\nValidate data\n\nHandle DTOs\n\nContain business logic",
      "autoResize": false,
      "lineHeight": 1.25
    },
