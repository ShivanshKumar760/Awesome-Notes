      "boundElements": null,
      "updated": 1764005912449,
      "link": null,
      "locked": false,
      "text": "6. Update Service Layer\n\nHere we convert DTO → Entity and Entity → DTO.\n\n@Service\npublic class StudentService {\n\n    @Autowired\n    private StudentRepository repo;\n\n    public String addStudent(StudentRequestDTO dto) {\n        Student s = new Student(0, dto.getName(), dto.getAge());\n        repo.add(s);\n        return \"Student Added Successfully!\";\n    }\n\n    public List<StudentResponseDTO> getAllStudents() {\n        return repo.getAll()\n                .stream()\n                .map(s -> new StudentResponseDTO(s.getId(), s.getName(), s.getAge()))\n                .toList();\n    }\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "6. Update Service Layer\n\nHere we convert DTO → Entity and Entity → DTO.\n\n@Service\npublic class StudentService {\n\n    @Autowired\n    private StudentRepository repo;\n\n    public String addStudent(StudentRequestDTO dto) {\n        Student s = new Student(0, dto.getName(), dto.getAge());\n        repo.add(s);\n        return \"Student Added Successfully!\";\n    }\n\n    public List<StudentResponseDTO> getAllStudents() {\n        return repo.getAll()\n                .stream()\n                .map(s -> new StudentResponseDTO(s.getId(), s.getName(), s.getAge()))\n                .toList();\n    }\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
