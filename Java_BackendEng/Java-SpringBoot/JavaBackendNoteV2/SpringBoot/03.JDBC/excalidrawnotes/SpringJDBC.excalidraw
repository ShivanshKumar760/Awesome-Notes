    {
      "id": "DMoykNy23njqOQ90in0wW",
      "type": "text",
      "x": 664.2612862355285,
      "y": 22051.623330429768,
      "width": 840.1081433261231,
      "height": 775,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHW",
      "roundness": null,
      "seed": 1033437710,
      "version": 109,
      "versionNonce": 853810770,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763998416773,
      "link": null,
      "locked": false,
      "text": "⭐ Why Devs Use H2?\n\nFast development\n\nPerfect for testing\n\nNo installation required\n\nSpring Boot auto-configures it\n\nVery lightweight (few MB)\n\n⭐ Example with Spring Boot\n\napplication.properties:\n\nspring.datasource.url=jdbc:h2:mem:testdb\nspring.datasource.driverClassName=org.h2.Driver\nspring.datasource.username=sa\nspring.datasource.password=\n\nspring.h2.console.enabled=true\n\n\nSpring Boot does:\n\n✔ Create H2 DataSource\n✔ Create HikariCP pool\n✔ Create JdbcTemplate / JPA EntityManager\n✔ Load schema.sql and data.sql\n✔ Open H2 console",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⭐ Why Devs Use H2?\n\nFast development\n\nPerfect for testing\n\nNo installation required\n\nSpring Boot auto-configures it\n\nVery lightweight (few MB)\n\n⭐ Example with Spring Boot\n\napplication.properties:\n\nspring.datasource.url=jdbc:h2:mem:testdb\nspring.datasource.driverClassName=org.h2.Driver\nspring.datasource.username=sa\nspring.datasource.password=\n\nspring.h2.console.enabled=true\n\n\nSpring Boot does:\n\n✔ Create H2 DataSource\n✔ Create HikariCP pool\n✔ Create JdbcTemplate / JPA EntityManager\n✔ Load schema.sql and data.sql\n✔ Open H2 console",
      "autoResize": false,
      "lineHeight": 1.25
    },
