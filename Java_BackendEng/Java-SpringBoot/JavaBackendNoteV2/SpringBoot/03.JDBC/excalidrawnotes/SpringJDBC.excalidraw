    {
      "id": "cIXg2WR4Wza3Gu8pAbix2",
      "type": "text",
      "x": 532.0553957521666,
      "y": 1498.2520605745335,
      "width": 810.7464771033397,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
