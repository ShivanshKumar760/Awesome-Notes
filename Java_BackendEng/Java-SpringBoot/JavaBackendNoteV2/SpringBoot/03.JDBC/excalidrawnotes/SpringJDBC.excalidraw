    {
      "id": "SbbsShzZAsh2EhNqT8cyV",
      "type": "text",
      "x": 687.0643103015816,
      "y": 19598.64614465393,
      "width": 484,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
