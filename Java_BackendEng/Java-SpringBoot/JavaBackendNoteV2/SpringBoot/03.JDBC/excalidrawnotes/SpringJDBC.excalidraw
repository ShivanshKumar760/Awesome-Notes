    {
      "id": "aTsM0XgXTmM4D7gMlm5zR",
      "type": "text",
      "x": 685.2645028926347,
      "y": 19964.73091153508,
      "width": 572,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
