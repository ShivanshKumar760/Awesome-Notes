      "updated": 1764005985898,
      "link": null,
      "locked": false,
      "text": "@RestController\n@RequestMapping(\"/student\")\npublic class StudentController {\n\n    @Autowired\n    private StudentService service;\n\n    @PostMapping(\"/add\")\n    public String add(@RequestBody StudentRequestDTO dto) {\n        return service.addStudent(dto);\n    }\n\n    @GetMapping(\"/all\")\n    public List<StudentResponseDTO> getAll() {\n        return service.getAllStudents();\n    }\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "@RestController\n@RequestMapping(\"/student\")\npublic class StudentController {\n\n    @Autowired\n    private StudentService service;\n\n    @PostMapping(\"/add\")\n    public String add(@RequestBody StudentRequestDTO dto) {\n        return service.addStudent(dto);\n    }\n\n    @GetMapping(\"/all\")\n    public List<StudentResponseDTO> getAll() {\n        return service.getAllStudents();\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
