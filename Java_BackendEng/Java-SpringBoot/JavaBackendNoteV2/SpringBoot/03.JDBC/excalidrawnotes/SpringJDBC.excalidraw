    {
      "id": "uJCFeWUbSpgUnOoijjAfr",
      "type": "text",
      "x": 569.1418741081349,
      "y": 5301.791379226835,
      "width": 506,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
