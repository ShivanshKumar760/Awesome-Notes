      "width": 961.2781220720509,
      "height": 32.60780604043588,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFo",
      "roundness": null,
      "seed": 734167660,
      "version": 257,
      "versionNonce": 563833172,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763991692501,
      "link": null,
      "locked": false,
      "text": "Let's look one by one how Spring JDBC is different from each other ",
      "fontSize": 26.086244832348736,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Let's look one by one how Spring JDBC is different from each other ",
      "autoResize": true,
      "lineHeight": 1.25
    },
