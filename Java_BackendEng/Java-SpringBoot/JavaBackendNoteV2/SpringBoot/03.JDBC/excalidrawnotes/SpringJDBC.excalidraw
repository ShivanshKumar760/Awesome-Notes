    {
      "id": "5LBWQm3ijK5tzTmT7x3qQ",
      "type": "text",
      "x": 666.1115306008084,
      "y": 14544.125992059184,
      "width": 781.5890012341415,
      "height": 950,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
