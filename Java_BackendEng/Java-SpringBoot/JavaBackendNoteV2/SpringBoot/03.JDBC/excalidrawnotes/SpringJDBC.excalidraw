    {
      "id": "-50vHMOqDv6HNNy2QJFsB",
      "type": "text",
      "x": 651.7454837479867,
      "y": 26872.318185292515,
      "width": 671,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHh",
      "roundness": null,
      "seed": 1833407886,
      "version": 28,
      "versionNonce": 1857078674,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763998918319,
      "link": null,
      "locked": false,
      "text": "Here is a clean, simple Student Management app using:\n\n✅ Spring Boot\n✅ Spring JDBC (JdbcTemplate)\n✅ H2 in-memory database\n✅ 2 APIs:\n\nPOST /student/add → add student\n\nGET /student/all → fetch all students\n\nThis is the smallest working example — perfect for beginners.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here is a clean, simple Student Management app using:\n\n✅ Spring Boot\n✅ Spring JDBC (JdbcTemplate)\n✅ H2 in-memory database\n✅ 2 APIs:\n\nPOST /student/add → add student\n\nGET /student/all → fetch all students\n\nThis is the smallest working example — perfect for beginners.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Hp7ZR9otaT-CSthhBkt36",
      "type": "text",
      "x": 663.4555130311801,
      "y": 27234.934919647803,
      "width": 627,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHi",
      "roundness": null,
      "seed": 736643342,
      "version": 32,
      "versionNonce": 1341341970,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763998934852,
      "link": null,
      "locked": false,
      "text": "🟦 1. pom.xml\n\nAdd Spring Web + Spring JDBC + H2:\n\n<dependencies>\n    <!-- Spring Web -->\n    <dependency>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-web</artifactId>\n    </dependency>\n\n    <!-- Spring JDBC -->\n    <dependency>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-jdbc</artifactId>\n    </dependency>\n\n    <!-- H2 Database -->\n    <dependency>\n        <groupId>com.h2database</groupId>\n        <artifactId>h2</artifactId>\n        <scope>runtime</scope>\n    </dependency>\n</dependencies>",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🟦 1. pom.xml\n\nAdd Spring Web + Spring JDBC + H2:\n\n<dependencies>\n    <!-- Spring Web -->\n    <dependency>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-web</artifactId>\n    </dependency>\n\n    <!-- Spring JDBC -->\n    <dependency>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-jdbc</artifactId>\n    </dependency>\n\n    <!-- H2 Database -->\n    <dependency>\n        <groupId>com.h2database</groupId>\n        <artifactId>h2</artifactId>\n        <scope>runtime</scope>\n    </dependency>\n</dependencies>",
      "autoResize": true,
      "lineHeight": 1.25
    },
