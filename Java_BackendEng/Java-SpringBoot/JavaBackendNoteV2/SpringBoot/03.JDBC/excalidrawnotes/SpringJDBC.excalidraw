      "seed": 278421332,
      "version": 9,
      "versionNonce": 377439212,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763994157681,
      "link": null,
      "locked": false,
      "text": "⭐ HikariCP Default Pool Size\n\nSpring Boot defaults:\n\nmaximumPoolSize = 10\nminimumIdle = 10\n\n\nYou can override:\n\nspring.datasource.hikari.maximum-pool-size=20\nspring.datasource.hikari.minimum-idle=5",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⭐ HikariCP Default Pool Size\n\nSpring Boot defaults:\n\nmaximumPoolSize = 10\nminimumIdle = 10\n\n\nYou can override:\n\nspring.datasource.hikari.maximum-pool-size=20\nspring.datasource.hikari.minimum-idle=5",
      "autoResize": true,
      "lineHeight": 1.25
    },
