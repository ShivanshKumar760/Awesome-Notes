    {
      "id": "MxQ9GUa0E4yd8MbVIu7se",
      "type": "text",
      "x": 575.3359600628012,
      "y": 50171.449424314895,
      "width": 987.0718877944997,
      "height": 665,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bT2",
      "roundness": null,
      "seed": 686422403,
      "version": 105,
      "versionNonce": 1003060397,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763878907086,
      "link": null,
      "locked": false,
      "text": "2. XML Configuration (spring.xml)\n\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<beans xmlns=\"http://www.springframework.org/schema/beans\"\n       xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n       xsi:schemaLocation=\"\n        http://www.springframework.org/schema/beans\n        https://www.springframework.org/schema/beans/spring-\nbeans.xsd\">\n\n    <!-- Bean 1 -->\n    <bean id=\"laptopBean\" class=\"org.example.Laptop\"/>\n\n    <!-- Bean 2: Constructor Injection -->\n    <bean id=\"studentBean\" class=\"org.example.Student\">\n        <constructor-arg ref=\"laptopBean\"/>\n    </bean>\n\n</beans",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. XML Configuration (spring.xml)\n\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<beans xmlns=\"http://www.springframework.org/schema/beans\"\n       xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n       xsi:schemaLocation=\"\n        http://www.springframework.org/schema/beans\n        https://www.springframework.org/schema/beans/spring-beans.xsd\">\n\n    <!-- Bean 1 -->\n    <bean id=\"laptopBean\" class=\"org.example.Laptop\"/>\n\n    <!-- Bean 2: Constructor Injection -->\n    <bean id=\"studentBean\" class=\"org.example.Student\">\n        <constructor-arg ref=\"laptopBean\"/>\n    </bean>\n\n</beans",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Sd-aZ00ioc-PYu0xHTKst",
      "type": "rectangle",
      "x": 562.886585825937,
      "y": 50232.39769773602,
      "width": 962.8566977650822,
      "height": 609.3523353317141,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bT3",
      "roundness": {
        "type": 3
      },
      "seed": 107607405,
