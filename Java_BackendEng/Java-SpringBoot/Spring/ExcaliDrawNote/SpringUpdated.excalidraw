      "originalText": "public class Student {\n    private Laptop laptop;\n\n    public void setLaptop(Laptop laptop) {   // setter required\n        this.laptop = laptop;\n    }\n\n    public void study() {\n        laptop.compile();\n    }\n}",
      "autoResize": true,
