    },
    {
      "id": "maQ1H8zXZLMHO5dDjn_b0",
      "type": "text",
      "x": 553.6361189265174,
      "y": 46107.226498299264,
      "width": 566.4609375,
      "height": 650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bSh",
      "roundness": null,
      "seed": 1682743565,
      "version": 49,
      "versionNonce": 1763659747,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763840672901,
      "link": null,
      "locked": false,
      "text": "Laptop.java\npublic class Laptop {\n    public void compile() {\n        System.out.println(\"Compiling...\");\n    }\n}\n\nspring.xml (Very important part)\n<bean id=\"laptop\" class=\"org.example.Laptop\"/>\n\n<bean id=\"student\" class=\"org.example.Student\">\n    <property name=\"laptop\" ref=\"laptop\"/>\n</bean>\n\n\n✔ Here Spring sees the setter:\n\nsetLaptop()\n\n\n✔ Matches it with property:\n\nproperty name=\"laptop\"\n\n\n✔ Injects the bean laptop into the Student object.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Laptop.java\npublic class Laptop {\n    public void compile() {\n        System.out.println(\"Compiling...\");\n    }\n}\n\nspring.xml (Very important part)\n<bean id=\"laptop\" class=\"org.example.Laptop\"/>\n\n<bean id=\"student\" class=\"org.example.Student\">\n    <property name=\"laptop\" ref=\"laptop\"/>\n</bean>\n\n\n✔ Here Spring sees the setter:\n\nsetLaptop()\n\n\n✔ Matches it with property:\n\nproperty name=\"laptop\"\n\n\n✔ Injects the bean laptop into the Student object.",
      "autoResize": true,
      "lineHeight": 1.25
    },
