    {
      "id": "hz9k87Hb6NcPD2RZAdp9r",
      "type": "text",
      "x": 738.1284840545226,
      "y": 26356.040629737137,
      "width": 418,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
