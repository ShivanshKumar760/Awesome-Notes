      "versionNonce": 592455885,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763811161487,
      "link": null,
      "locked": false,
      "text": "1.@Component\n\n2.@Service\n\n3.@Repository                             \n\n4.@Controller                             this object notation  \n                                          automatically create\nobject\n\n5.@Configuration\n\n6.@Bean",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.@Component\n\n2.@Service\n\n3.@Repository                             \n\n4.@Controller                             this object notation  \n                                          automatically create object\n\n5.@Configuration\n\n6.@Bean",
      "autoResize": false,
      "lineHeight": 1.25
    },
