      "link": null,
      "locked": false,
      "text": "Why Constructor Injection Is Best in XML?\n\n->Prevents null dependencies\n\n->Forces required dependencies\n\n->Works well with immutable design\n\n->Easy to understand what the object needs",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why Constructor Injection Is Best in XML?\n\n->Prevents null dependencies\n\n->Forces required dependencies\n\n->Works well with immutable design\n\n->Easy to understand what the object needs",
      "autoResize": true,
      "lineHeight": 1.25
    },
