    {
      "id": "lLlXm5FjBDMqzN0x2CfWY",
      "type": "text",
      "x": 574.0247772158373,
      "y": 58080.070109711676,
      "width": 715,
      "height": 800,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bTq",
      "roundness": null,
      "seed": 257976803,
      "version": 36,
      "versionNonce": 580041965,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763881038637,
      "link": null,
      "locked": false,
      "text": "Spring DI Makes Loose Coupling Very Easy\n\nInstead of:\n\nDriver d = new Driver(new ElectricCar());\n\n\nSpring does:\n\n@Autowired\nVehicle vehicle;\n\n\nOr via constructor:\n\npublic Driver(Vehicle vehicle) {\n    this.vehicle = vehicle;\n}\n\n\nSpring decides whether to give:\n\nCar\n\nElectricCar\n\nBike\n\nBus\n\nThis is where IoC (Inversion of Control) helps → YOU don’t decide\nwhich object to create.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Spring DI Makes Loose Coupling Very Easy\n\nInstead of:\n\nDriver d = new Driver(new ElectricCar());\n\n\nSpring does:\n\n@Autowired\nVehicle vehicle;\n\n\nOr via constructor:\n\npublic Driver(Vehicle vehicle) {\n    this.vehicle = vehicle;\n}\n\n\nSpring decides whether to give:\n\nCar\n\nElectricCar\n\nBike\n\nBus\n\nThis is where IoC (Inversion of Control) helps → YOU don’t decide which object to create.",
      "autoResize": false,
      "lineHeight": 1.25
    },
