    {
      "id": "E2voecDNS47dmCAH1dDyQ",
      "type": "text",
      "x": 601.6969114205818,
      "y": 43430.438088446776,
      "width": 649,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
