      "isDeleted": false,
      "boundElements": null,
      "updated": 1763883183226,
      "link": null,
      "locked": false,
      "text": "📌 Class Example\nStudent.java\npublic class Student {\n\n    private Laptop laptop;\n\n    public void setLaptop(Laptop laptop) {\n        this.laptop = laptop;\n    }\n\n    public void study() {\n        laptop.compile();\n    }\n}\n\nspring.xml\n<bean id=\"laptop1\" class=\"org.example.Laptop\" primary=\"true\"/>\n<bean id=\"laptop2\" class=\"org.example.Laptop\"/>\n\n<bean id=\"student\" class=\"org.example.Student\" autowire=\"byType\"/>\n\n\n✔ No error\n✔ Spring injects laptop1",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "📌 Class Example\nStudent.java\npublic class Student {\n\n    private Laptop laptop;\n\n    public void setLaptop(Laptop laptop) {\n        this.laptop = laptop;\n    }\n\n    public void study() {\n        laptop.compile();\n    }\n}\n\nspring.xml\n<bean id=\"laptop1\" class=\"org.example.Laptop\" primary=\"true\"/>\n<bean id=\"laptop2\" class=\"org.example.Laptop\"/>\n\n<bean id=\"student\" class=\"org.example.Student\" autowire=\"byType\"/>\n\n\n✔ No error\n✔ Spring injects laptop1",
      "autoResize": false,
      "lineHeight": 1.25
    },
