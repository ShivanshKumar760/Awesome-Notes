    {
      "id": "admaxK7xdkUZ5aakl1erJ",
      "type": "text",
      "x": 953.3584728065908,
      "y": 20921.869969140775,
      "width": 429,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
