    {
      "id": "Q9IIdZMiS6RL-_hPB4941",
      "type": "text",
      "x": 665.3430015025194,
      "y": 73425.43857803755,
      "width": 627,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bVQ",
      "roundness": null,
      "seed": 293178381,
      "version": 65,
      "versionNonce": 1990537027,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763883125104,
      "link": null,
      "locked": false,
      "text": "⭐ Primary Bean in XML = primary=\"true\"\n\nSpring Core XML allows marking one bean as primary using:\n\nprimary=\"true\"",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⭐ Primary Bean in XML = primary=\"true\"\n\nSpring Core XML allows marking one bean as primary using:\n\nprimary=\"true\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
