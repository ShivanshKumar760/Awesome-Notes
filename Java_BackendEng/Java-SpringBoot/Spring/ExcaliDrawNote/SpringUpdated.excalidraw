        1,
        1
      ],
      "crop": null
    },
    {
      "id": "pONQv27FSei7TEH2OKfIc",
      "type": "text",
      "x": 699.0186749733816,
      "y": 68125.29055999465,
      "width": 1017.4609375,
      "height": 650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bUl",
      "roundness": null,
      "seed": 623626691,
      "version": 122,
      "versionNonce": 1021794403,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763882722140,
      "link": null,
      "locked": false,
      "text": "1. Autowiring byName\n\nSpring injects dependency by matching property name with bean id.\n\nStudent.java\npublic class Student {\n    private Laptop laptop;\n\n    public void setLaptop(Laptop laptop) {   // setter required\n        this.laptop = laptop;\n    }\n\n    public void study() {\n        laptop.compile();\n    }\n}\n\nspring.xml\n<bean id=\"laptop\" class=\"org.example.Laptop\"/>\n\n<bean id=\"student\" class=\"org.example.Student\" autowire=\"byName\"/>\n\n\n✔ setLaptop() → property = laptop\n✔ Spring finds bean id = laptop(Note for byName to work bean Id should match property name)\n✔ Injects it automatically",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Autowiring byName\n\nSpring injects dependency by matching property name with bean id.\n\nStudent.java\npublic class Student {\n    private Laptop laptop;\n\n    public void setLaptop(Laptop laptop) {   // setter required\n        this.laptop = laptop;\n    }\n\n    public void study() {\n        laptop.compile();\n    }\n}\n\nspring.xml\n<bean id=\"laptop\" class=\"org.example.Laptop\"/>\n\n<bean id=\"student\" class=\"org.example.Student\" autowire=\"byName\"/>\n\n\n✔ setLaptop() → property = laptop\n✔ Spring finds bean id = laptop(Note for byName to work bean Id should match property name)\n✔ Injects it automatically",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
