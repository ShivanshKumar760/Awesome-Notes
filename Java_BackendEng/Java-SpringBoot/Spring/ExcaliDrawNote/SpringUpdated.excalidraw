    {
      "id": "HT9qkb1v3ycoGvYpKWFnA",
      "type": "text",
      "x": 605.7183367590466,
      "y": 48761.271565731906,
      "width": 708.3997802734375,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
