      "versionNonce": 1056941859,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763807536865,
      "link": null,
      "locked": false,
      "text": "Example (Spring WITHOUT Boot):this is how we have to manuallu\nconfigure bean in spring boot (what is bean it's a spring managed object)\n\n<bean id=\"student\" class=\"com.example.Student\"/>\n<bean id=\"laptop\" class=\"com.example.Laptop\"/>\n\n\nVery manual. Lots of setup.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example (Spring WITHOUT Boot):this is how we have to manuallu\nconfigure bean in spring boot (what is bean it's a spring managed object)\n\n<bean id=\"student\" class=\"com.example.Student\"/>\n<bean id=\"laptop\" class=\"com.example.Laptop\"/>\n\n\nVery manual. Lots of setup.",
      "autoResize": true,
      "lineHeight": 1.25
    },
