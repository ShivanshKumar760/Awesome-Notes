      "versionNonce": 94981667,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763883149340,
      "link": null,
      "locked": false,
      "text": "🔥 Example: Making One Bean Primary\nStep 1 — Two beans of same type\n\n<bean id=\"laptop1\" class=\"org.example.Laptop\" primary=\"true\" />\n<bean id=\"laptop2\" class=\"org.example.Laptop\" />\n\nStep 2 — Autowire by type\n<bean id=\"student\" class=\"org.example.Student\" autowire=\"byType\"/>\n\nResult\n\n✔ Spring sees two Laptop beans\n✔ One is marked primary=\"true\"\n✔ Spring injects laptop1",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🔥 Example: Making One Bean Primary\nStep 1 — Two beans of same type\n\n<bean id=\"laptop1\" class=\"org.example.Laptop\" primary=\"true\" />\n<bean id=\"laptop2\" class=\"org.example.Laptop\" />\n\nStep 2 — Autowire by type\n<bean id=\"student\" class=\"org.example.Student\" autowire=\"byType\"/>\n\nResult\n\n✔ Spring sees two Laptop beans\n✔ One is marked primary=\"true\"\n✔ Spring injects laptop1",
      "autoResize": false,
      "lineHeight": 1.25
    },
