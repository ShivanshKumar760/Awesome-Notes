    {
      "id": "0mUsMVw7la5gHYXX4y5pl",
      "type": "text",
      "x": 422.54013749015405,
      "y": 11660.234676312966,
      "width": 748,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
