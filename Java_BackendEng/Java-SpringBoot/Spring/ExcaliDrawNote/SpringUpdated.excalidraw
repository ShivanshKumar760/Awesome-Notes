    {
      "id": "ZtHrHijIsnmD3HTk8nUjM",
      "type": "text",
      "x": 514.9876529883276,
      "y": 3020.0577310476533,
      "width": 649,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
