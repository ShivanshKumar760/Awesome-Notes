    },
    {
      "id": "3gQkNBRSqx8GEOWbpjopc",
      "type": "text",
      "x": 723.3627504109312,
      "y": 67265.99403213225,
      "width": 169.39993286132812,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bUO",
      "roundness": null,
      "seed": 1515807043,
      "version": 19,
      "versionNonce": 2082248493,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763882583314,
      "link": null,
      "locked": false,
      "text": "AutoWiring:",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AutoWiring:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "N0v6jJRnSr5DtBKW41mny",
      "type": "text",
      "x": 719.936166417058,
      "y": 67315.83054749409,
      "width": 792,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bUP",
      "roundness": null,
      "seed": 60321773,
      "version": 51,
      "versionNonce": 1874482659,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763882601441,
      "link": null,
      "locked": false,
      "text": "Autowiring means:\n\nSpring automatically finds and injects the correct bean into your class \nusing XML configuration, without using @Autowired.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Autowiring means:\n\nSpring automatically finds and injects the correct bean into your class \nusing XML configuration, without using @Autowired.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "11arkq8pwvbbvFmqsXyBY",
      "type": "text",
      "x": 714.9740285363341,
      "y": 67474.85967155767,
      "width": 605,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bUQ",
      "roundness": null,
      "seed": 346737763,
      "version": 43,
      "versionNonce": 139507053,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763882614576,
      "link": null,
      "locked": false,
      "text": "Instead of manually writing:\n\n<property name=\"laptop\" ref=\"laptop\" />\n\n\nYou tell Spring:\n\n<bean id=\"student\" class=\"Student\" autowire=\"byType\" />\n\n\nSpring automatically injects the dependency.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Instead of manually writing:\n\n<property name=\"laptop\" ref=\"laptop\" />\n\n\nYou tell Spring:\n\n<bean id=\"student\" class=\"Student\" autowire=\"byType\" />\n\n\nSpring automatically injects the dependency.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EktcL6jbrB-6AfsCfIvaS",
      "type": "rectangle",
      "x": 698.2348236162438,
      "y": 67463.87655095123,
      "width": 708.7220854874704,
      "height": 308.9593309406191,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bUR",
      "roundness": {
        "type": 3
      },
      "seed": 652275587,
      "version": 100,
      "versionNonce": 976614605,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763882620225,
      "link": null,
      "locked": false
    },
    {
      "id": "Qlt6Kib_FLR83hvS-Y_M0",
      "type": "image",
      "x": 713.5090285130497,
      "y": 67803.07506703265,
      "width": 824.3724781364583,
      "height": 299.02238070586077,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
