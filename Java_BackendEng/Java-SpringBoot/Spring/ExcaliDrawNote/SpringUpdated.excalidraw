    {
      "id": "f6StB8Bwty0SV80X2n_zF",
      "type": "text",
      "x": 497.3840592866245,
      "y": 1002.4386364801794,
      "width": 698.4609375,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
