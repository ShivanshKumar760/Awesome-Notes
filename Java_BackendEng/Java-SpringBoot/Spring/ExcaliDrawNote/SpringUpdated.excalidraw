      "version": 14,
      "versionNonce": 1038520461,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763812298312,
      "link": null,
      "locked": false,
      "text": "1.Constructor Injection (BEST)\n2.Setter Injection\n3.Field Injection (Not recommended)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.Constructor Injection (BEST)\n2.Setter Injection\n3.Field Injection (Not recommended)",
      "autoResize": true,
      "lineHeight": 1.25
    },
