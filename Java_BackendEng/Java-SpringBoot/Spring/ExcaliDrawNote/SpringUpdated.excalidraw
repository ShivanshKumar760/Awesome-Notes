    },
    {
      "id": "BKiHK2Dp6zTEdBfFt0_Kx",
      "type": "text",
      "x": 577.3346507702088,
      "y": 51994.693733279295,
      "width": 1060.7422999329708,
      "height": 735,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bTB",
      "roundness": null,
      "seed": 847519651,
      "version": 133,
      "versionNonce": 1234888685,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763879127255,
      "link": null,
      "locked": false,
      "text": "What if Constructor Has Multiple Parameters?\nStudent.java\npublic class Student {\n    private Laptop laptop;\n    private int id;\n\n    public Student(Laptop laptop, int id) {\n        this.laptop = laptop;\n        this.id = id;\n    }\n}\n\nspring.xml\n<bean id=\"student\" class=\"org.example.Student\">\n    <constructor-arg ref=\"laptopBean\"/>\n    <constructor-arg value=\"101\"/>\n</bean>\n\n\n✔ Order matters if you don’t use index or name\n✔ Spring injects laptop first, id second",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What if Constructor Has Multiple Parameters?\nStudent.java\npublic class Student {\n    private Laptop laptop;\n    private int id;\n\n    public Student(Laptop laptop, int id) {\n        this.laptop = laptop;\n        this.id = id;\n    }\n}\n\nspring.xml\n<bean id=\"student\" class=\"org.example.Student\">\n    <constructor-arg ref=\"laptopBean\"/>\n    <constructor-arg value=\"101\"/>\n</bean>\n\n\n✔ Order matters if you don’t use index or name\n✔ Spring injects laptop first, id second",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "x6ScO6vmy5885lFthUeXZ",
