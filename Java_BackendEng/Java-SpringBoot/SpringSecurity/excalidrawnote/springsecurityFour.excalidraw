      "text": "Instead of using the default username and password, you can also create\nyour username and password in your “application.properties”.\n\nspring.security.user.name=<name>\nspring.security.user.password=<password>",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Instead of using the default username and password, you can also create your username and password in your “application.properties”.\n\nspring.security.user.name=<name>\nspring.security.user.password=<password>",
      "autoResize": false,
      "lineHeight": 1.25
