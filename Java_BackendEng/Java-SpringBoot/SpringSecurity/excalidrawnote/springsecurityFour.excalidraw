    {
      "id": "unI_tmcsT2lX6mTPRvwuB",
      "type": "text",
      "x": -349.72380254020754,
      "y": 98631.89968466201,
      "width": 693,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "blH",
      "roundness": null,
      "seed": 383197345,
      "version": 27,
      "versionNonce": 1796860207,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767018119139,
      "link": null,
      "locked": false,
      "text": "9️⃣ How to define your own provider (optional but powerful)\n@Component\npublic class MyAuthProvider implements AuthenticationProvider {\n\n    @Override\n    public Authentication authenticate(Authentication auth) {\n        // custom logic\n    }\n\n    @Override\n    public boolean supports(Class<?> clazz) {\n        return MyAuthToken.class.isAssignableFrom(clazz);\n    }\n}\n\n\nSpring auto-picks it 🔥",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "9️⃣ How to define your own provider (optional but powerful)\n@Component\npublic class MyAuthProvider implements AuthenticationProvider {\n\n    @Override\n    public Authentication authenticate(Authentication auth) {\n        // custom logic\n    }\n\n    @Override\n    public boolean supports(Class<?> clazz) {\n        return MyAuthToken.class.isAssignableFrom(clazz);\n    }\n}\n\n\nSpring auto-picks it 🔥",
      "autoResize": true,
      "lineHeight": 1.25
    },
