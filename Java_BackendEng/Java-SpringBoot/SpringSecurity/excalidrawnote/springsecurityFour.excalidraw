    {
      "id": "DP6Y-Ic4DzXhf1WvdDhOy",
      "type": "text",
      "x": 456.6467408588777,
      "y": 33471.677809591645,
      "width": 1105.7295354621263,
      "height": 586.4838638704022,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bh1",
