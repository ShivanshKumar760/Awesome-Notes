      "updated": 1767020896984,
      "link": null,
      "locked": false,
      "text": "🔴 Key Distinction (VERY IMPORTANT)\n\nYou are creating ONLY the input Authentication\nobject\nSpring creates the output Authentication object\n\nThey are NOT the same object",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🔴 Key Distinction (VERY IMPORTANT)\n\nYou are creating ONLY the input Authentication object\nSpring creates the output Authentication object\n\nThey are NOT the same object",
      "autoResize": false,
      "lineHeight": 1.25
    },
