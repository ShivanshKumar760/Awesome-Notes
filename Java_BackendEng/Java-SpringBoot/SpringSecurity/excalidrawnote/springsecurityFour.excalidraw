      "seed": 1873603009,
      "version": 154,
      "versionNonce": 1248166479,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766919815012,
      "link": null,
      "locked": false,
      "text": "3️⃣ Compare with Express Middleware (Perfect Analogy)\nExpress (Node.js)\napp.use((req, res, next) => {\n    console.log(\"Before controller\");\n    next();\n    console.log(\"After controller\");\n});\n\nSpring Filter\n@Override\npublic void doFilter(ServletRequest request,\n                     ServletResponse response,\n                     FilterChain chain)\n        throws IOException, ServletException {\n\n    System.out.println(\"Before controller\");\n\n    chain.doFilter(request, response); // 👈 SAME AS next()\n\n    System.out.println(\"After controller\");\n}",
      "fontSize": 22.34224243315818,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3️⃣ Compare with Express Middleware (Perfect Analogy)\nExpress (Node.js)\napp.use((req, res, next) => {\n    console.log(\"Before controller\");\n    next();\n    console.log(\"After controller\");\n});\n\nSpring Filter\n@Override\npublic void doFilter(ServletRequest request,\n                     ServletResponse response,\n                     FilterChain chain)\n        throws IOException, ServletException {\n\n    System.out.println(\"Before controller\");\n\n    chain.doFilter(request, response); // 👈 SAME AS next()\n\n    System.out.println(\"After controller\");\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
