      "updated": 1766921527402,
      "link": null,
      "locked": false,
      "text": "Now that we are familiar  with Spring Security Filter let's dive a bit more deep and we will\ntake a example of todoapi and authenticate its route using jwt and in the process we will understand \nthe whole mechanism  of spring security",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now that we are familiar  with Spring Security Filter let's dive a bit more deep and we will\ntake a example of todoapi and authenticate its route using jwt and in the process we will understand \nthe whole mechanism  of spring security",
      "autoResize": true,
      "lineHeight": 1.25
    },
