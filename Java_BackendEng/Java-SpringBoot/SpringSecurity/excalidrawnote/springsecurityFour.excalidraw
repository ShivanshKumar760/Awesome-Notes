    {
      "id": "EYU28NowVTn57xFJVnP4Y",
      "type": "text",
      "x": -967.9128033397407,
      "y": 134102.27020947108,
      "width": 792,
      "height": 775,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bns",
