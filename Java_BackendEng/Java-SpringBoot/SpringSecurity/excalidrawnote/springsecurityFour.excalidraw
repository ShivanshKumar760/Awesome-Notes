    {
      "id": "z0T1DGs2mbsjiMrxKYfLz",
      "type": "text",
      "x": -327.6463951196922,
      "y": 85009.30860053466,
      "width": 923.4143579667887,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bjr",
      "roundness": null,
      "seed": 921464655,
      "version": 104,
      "versionNonce": 392360993,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766945506629,
      "link": null,
      "locked": false,
      "text": "5️⃣ What happens AFTER login?\nJWT is created\njwtUtil.generateToken(username);\n\n6️⃣ Now IMPORTANT PART 🚨\nAuthenticationManager is NOT used anymore\n\n❌ NOT used in:\n\nJwtFilter\n\nTodoController\n\nAny secured endpoint\n\nWhy?\n\nBecause:\n\nJWT itself is the proof of authentication",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5️⃣ What happens AFTER login?\nJWT is created\njwtUtil.generateToken(username);\n\n6️⃣ Now IMPORTANT PART 🚨\nAuthenticationManager is NOT used anymore\n\n❌ NOT used in:\n\nJwtFilter\n\nTodoController\n\nAny secured endpoint\n\nWhy?\n\nBecause:\n\nJWT itself is the proof of authentication",
      "autoResize": false,
      "lineHeight": 1.25
    },
