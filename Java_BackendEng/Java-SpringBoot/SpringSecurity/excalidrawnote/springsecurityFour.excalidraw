    {
      "id": "-bHyRHR9l9gxLcnNe-2XK",
      "type": "text",
      "x": -956.2117245907284,
      "y": 129307.6326693281,
      "width": 792,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bng",
      "roundness": null,
      "seed": 1478407713,
      "version": 39,
      "versionNonce": 1330499905,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767022567071,
      "link": null,
      "locked": false,
      "text": "🧩 Let’s look at your constructors side-by-side\n// BEFORE authentication\npublic MyAuthToken(Object principal, Object credentials) {\n    super(null);\n    this.principal = principal;\n    this.credentials = credentials;\n    setAuthenticated(false);\n}\n\n// AFTER authentication\npublic MyAuthToken(Object principal,\n                   Collection<? extends GrantedAuthority> authorities) {\n    super(authorities);\n    this.principal = principal;\n    this.credentials = null;\n    setAuthenticated(true);\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🧩 Let’s look at your constructors side-by-side\n// BEFORE authentication\npublic MyAuthToken(Object principal, Object credentials) {\n    super(null);\n    this.principal = principal;\n    this.credentials = credentials;\n    setAuthenticated(false);\n}\n\n// AFTER authentication\npublic MyAuthToken(Object principal,\n                   Collection<? extends GrantedAuthority> authorities) {\n    super(authorities);\n    this.principal = principal;\n    this.credentials = null;\n    setAuthenticated(true);\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
