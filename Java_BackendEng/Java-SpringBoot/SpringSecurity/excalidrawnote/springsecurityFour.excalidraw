    {
      "id": "480MZUkOu1CT53CCS0gV_",
      "type": "text",
      "x": -459.33103868849275,
      "y": 113786.41239371519,
      "width": 1185.799560546875,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
