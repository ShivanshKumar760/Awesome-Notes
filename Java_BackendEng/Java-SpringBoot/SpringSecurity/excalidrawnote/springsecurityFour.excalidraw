    {
      "id": "5h8fiuoEQNgN9JLfBm0ml",
      "type": "text",
      "x": -329.5102352501782,
      "y": 86405.67496436062,
      "width": 890.4563610706202,
      "height": 490,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
