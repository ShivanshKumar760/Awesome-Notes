    {
      "id": "KeJ3upvhLn5Ug_E5vjmHN",
      "type": "text",
      "x": 499.4343455606622,
      "y": 19976.75804965709,
      "width": 335.4609375,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bfz",
      "roundness": null,
      "seed": 942774881,
      "version": 36,
      "versionNonce": 253597327,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766917309695,
      "link": null,
      "locked": false,
      "text": "🔁 High-level Request Flow\nClient (Postman / Browser)\n        ↓\n   Servlet Container (Tomcat)\n        ↓\n   FILTERS  ← 🛑 HERE\n        ↓\n   DispatcherServlet\n        ↓\n   Controller\n\n\nSo yes 👇\n👉 Filters act like middleware",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🔁 High-level Request Flow\nClient (Postman / Browser)\n        ↓\n   Servlet Container (Tomcat)\n        ↓\n   FILTERS  ← 🛑 HERE\n        ↓\n   DispatcherServlet\n        ↓\n   Controller\n\n\nSo yes 👇\n👉 Filters act like middleware",
      "autoResize": true,
      "lineHeight": 1.25
    },
