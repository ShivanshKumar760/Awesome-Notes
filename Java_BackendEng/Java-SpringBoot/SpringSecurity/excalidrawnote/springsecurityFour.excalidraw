    {
      "id": "tU67c-eZqfmpyElkK7nN_",
      "type": "text",
      "x": -315.5937091823687,
      "y": 89108.51538908221,
      "width": 785.399658203125,
      "height": 875,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bk0",
      "roundness": null,
      "seed": 523145793,
      "version": 123,
      "versionNonce": 571391279,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766946122375,
      "link": null,
      "locked": false,
      "text": "Authenticated request\n/todos\n→ JwtFilter\n→ JwtUtil\n→ UserDetailsService\n→ SecurityContext\n→ Controller\n\n\n🚫 No AuthenticationManager\n🚫 No AuthenticationProvider\n\n🔥 Why AuthenticationManager exists at all then?\n\nBecause:\n\nAuth type          Who authenticates\n\nForm login  ->      AuthenticationManager\nBasic auth  ->      AuthenticationManager\nOAuth2      ->      AuthenticationManager\nJWT         ->       YOUR FILTER\n\nJWT is stateless, so you must authenticate manually\nper request.",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Authenticated request\n/todos\n→ JwtFilter\n→ JwtUtil\n→ UserDetailsService\n→ SecurityContext\n→ Controller\n\n\n🚫 No AuthenticationManager\n🚫 No AuthenticationProvider\n\n🔥 Why AuthenticationManager exists at all then?\n\nBecause:\n\nAuth type          Who authenticates\n\nForm login  ->      AuthenticationManager\nBasic auth  ->      AuthenticationManager\nOAuth2      ->      AuthenticationManager\nJWT         ->       YOUR FILTER\n\nJWT is stateless, so you must authenticate manually per request.",
      "autoResize": false,
      "lineHeight": 1.25
    },
