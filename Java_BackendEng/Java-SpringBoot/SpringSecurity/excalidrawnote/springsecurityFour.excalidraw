        {
          "id": "2SCAYcHcSeTuHdz4P9jmL",
          "type": "arrow"
        }
      ],
      "updated": 1767018561689,
      "link": null,
      "locked": false,
      "text": "2️⃣ What does DaoAuthenticationProvider say?\n\nInside Spring Security source code:\n\n@Override\npublic boolean supports(Class<?> authentication) {\n    return\nUsernamePasswordAuthenticationToken.class\n            .isAssignableFrom(authentication);\n}\n\n\n✔ Match found",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2️⃣ What does DaoAuthenticationProvider say?\n\nInside Spring Security source code:\n\n@Override\npublic boolean supports(Class<?> authentication) {\n    return UsernamePasswordAuthenticationToken.class\n            .isAssignableFrom(authentication);\n}\n\n\n✔ Match found",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "M3ooDW33HZspsLYyp1Gyh",
      "type": "text",
      "x": -566.0136307232273,
      "y": 101471.981915677,
      "width": 561,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "blc",
      "roundness": null,
      "seed": 41850497,
      "version": 48,
      "versionNonce": 1497950209,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "2SCAYcHcSeTuHdz4P9jmL",
          "type": "arrow"
        }
      ],
      "updated": 1767018559812,
      "link": null,
      "locked": false,
      "text": "for (AuthenticationProvider provider : providers) {\n    if (provider.supports(auth.getClass())) {\n        return provider.authenticate(auth);\n    }\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for (AuthenticationProvider provider : providers) {\n    if (provider.supports(auth.getClass())) {\n        return provider.authenticate(auth);\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
