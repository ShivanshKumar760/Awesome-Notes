    {
      "id": "hnltBU-W2Jp6sROD_5TL4",
      "type": "text",
      "x": -963.5691266822016,
      "y": 131985.46288747602,
      "width": 1020.7527141096166,
      "height": 950,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bnp",
      "roundness": null,
      "seed": 1680663151,
      "version": 42,
      "versionNonce": 1317134017,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767022744915,
      "link": null,
      "locked": false,
      "text": "2️⃣ Create Custom AuthenticationProvider\nMyAuthProvider.java\nimport org.springframework.security.authentication.AuthenticationProvider;\nimport org.springframework.security.core.Authentication;\nimport org.springframework.security.core.authority.SimpleGrantedAuthority;\nimport org.springframework.stereotype.Component;\n\nimport java.util.List;\n\n@Component\npublic class MyAuthProvider implements AuthenticationProvider {\n\n    @Override\n    public Authentication authenticate(Authentication authentication) {\n\n        String username = authentication.getPrincipal().toString();\n        String secret = authentication.getCredentials().toString();\n\n        // 🔥 CUSTOM LOGIC\n        if (!\"admin\".equals(username) || !\"secret123\".equals(secret)) {\n            throw new RuntimeException(\"Invalid credentials\");\n        }\n\n        // AUTHENTICATED TOKEN\n        return new MyAuthToken(\n                username,\n                List.of(new SimpleGrantedAuthority(\"ROLE_USER\"))\n        );\n    }\n\n    @Override\n    public boolean supports(Class<?> authType) {\n        return MyAuthToken.class.isAssignableFrom(authType);\n    }\n}\n\n\n🔥 THIS is where Spring decides to use your provider",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2️⃣ Create Custom AuthenticationProvider\nMyAuthProvider.java\nimport org.springframework.security.authentication.AuthenticationProvider;\nimport org.springframework.security.core.Authentication;\nimport org.springframework.security.core.authority.SimpleGrantedAuthority;\nimport org.springframework.stereotype.Component;\n\nimport java.util.List;\n\n@Component\npublic class MyAuthProvider implements AuthenticationProvider {\n\n    @Override\n    public Authentication authenticate(Authentication authentication) {\n\n        String username = authentication.getPrincipal().toString();\n        String secret = authentication.getCredentials().toString();\n\n        // 🔥 CUSTOM LOGIC\n        if (!\"admin\".equals(username) || !\"secret123\".equals(secret)) {\n            throw new RuntimeException(\"Invalid credentials\");\n        }\n\n        // AUTHENTICATED TOKEN\n        return new MyAuthToken(\n                username,\n                List.of(new SimpleGrantedAuthority(\"ROLE_USER\"))\n        );\n    }\n\n    @Override\n    public boolean supports(Class<?> authType) {\n        return MyAuthToken.class.isAssignableFrom(authType);\n    }\n}\n\n\n🔥 THIS is where Spring decides to use your provider",
      "autoResize": false,
      "lineHeight": 1.25
    },
