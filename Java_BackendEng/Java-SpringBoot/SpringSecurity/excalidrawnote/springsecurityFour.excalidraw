      "updated": 1766926661196,
      "link": null,
      "locked": false,
      "text": "What does this do ,well it \nit creates a Authentication/\nUsernamePasswordAuthenticationToken\nObject -auth which is created\nafter token validation and if\ntoken is not validated\nit wont be created so we wont be able \nto access restricted route",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What does this do ,well it \nit creates a Authentication/\nUsernamePasswordAuthenticationToken\nObject -auth which is created\nafter token validation and if\ntoken is not validated\nit wont be created so we wont be able \nto access restricted route",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XG3im7TwE6X8rLH8OhuFm",
      "type": "text",
      "x": -255.89878911917776,
      "y": 74810.13354031403,
      "width": 1023.1025427888432,
      "height": 805,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bjL",
      "roundness": null,
      "seed": 1496378721,
      "version": 56,
      "versionNonce": 140680975,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "3JHooS_8ZME0bC3o56X1z",
          "type": "arrow"
        }
      ],
      "updated": 1766926708048,
      "link": null,
      "locked": false,
      "text": "8️⃣ TodoController (JWT AUTH FLOW)\n@RestController\n@RequestMapping(\"/todos\")\npublic class TodoController {\n\n    private final TodoRepository repo;\n\n    public TodoController(TodoRepository repo) {\n        this.repo = repo;\n    }\n\n    @PostMapping\n    public TodoEntity create(@RequestBody TodoEntity todo,\n                             Authentication auth) {\n        todo.setUsername(auth.getName());\n        return repo.save(todo);\n    }\n\n    @GetMapping\n    public List<TodoEntity> list(Authentication auth) {\n        return repo.findByUsername(auth.getName());\n    }\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "8️⃣ TodoController (JWT AUTH FLOW)\n@RestController\n@RequestMapping(\"/todos\")\npublic class TodoController {\n\n    private final TodoRepository repo;\n\n    public TodoController(TodoRepository repo) {\n        this.repo = repo;\n    }\n\n    @PostMapping\n    public TodoEntity create(@RequestBody TodoEntity todo,\n                             Authentication auth) {\n        todo.setUsername(auth.getName());\n        return repo.save(todo);\n    }\n\n    @GetMapping\n    public List<TodoEntity> list(Authentication auth) {\n        return repo.findByUsername(auth.getName());\n    }\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
