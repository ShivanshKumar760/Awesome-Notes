    {
      "id": "QkI6dedM2hsWLtqhj4BpY",
      "type": "text",
      "x": -858.5949303869907,
      "y": 117184.36542198711,
      "width": 1231.9358603555174,
      "height": 665,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
