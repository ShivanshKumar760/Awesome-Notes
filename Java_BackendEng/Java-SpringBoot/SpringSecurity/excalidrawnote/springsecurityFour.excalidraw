      "seed": 1780674639,
      "version": 251,
      "versionNonce": 1984777185,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767021880325,
      "link": null,
      "locked": false,
      "text": "why are we \nusing AbstractAuthenticationToken and not Authentication class \nor UsernamePasswordAuthenticationToken this is cause of spring security \nsystem design",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "why are we \nusing AbstractAuthenticationToken and not Authentication class \nor UsernamePasswordAuthenticationToken this is cause of spring security \nsystem design",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ifa8pzQJCiXkuE8HROzvA",
      "type": "text",
      "x": 78.85251136124907,
      "y": 121852.84097570088,
      "width": 715,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bnC",
      "roundness": null,
      "seed": 1987242881,
      "version": 39,
      "versionNonce": 575010255,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767021911292,
      "link": null,
      "locked": false,
      "text": "❓ Why do we extend AbstractAuthenticationToken\n❌ Why NOT Authentication\n❌ Why NOT UsernamePasswordAuthenticationToken\n1️⃣ First: what Authentication actually is\npublic interface Authentication extends Principal, Serializable {\n    Object getPrincipal();\n    Object getCredentials();\n    Collection<? extends GrantedAuthority> getAuthorities();\n    boolean isAuthenticated();\n    void setAuthenticated(boolean isAuthenticated);\n}\n\n\n👉 This is ONLY a contract\n\nNo fields\n\nNo logic\n\nNo storage\n\nNo defaults",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "❓ Why do we extend AbstractAuthenticationToken\n❌ Why NOT Authentication\n❌ Why NOT UsernamePasswordAuthenticationToken\n1️⃣ First: what Authentication actually is\npublic interface Authentication extends Principal, Serializable {\n    Object getPrincipal();\n    Object getCredentials();\n    Collection<? extends GrantedAuthority> getAuthorities();\n    boolean isAuthenticated();\n    void setAuthenticated(boolean isAuthenticated);\n}\n\n\n👉 This is ONLY a contract\n\nNo fields\n\nNo logic\n\nNo storage\n\nNo defaults",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XILmJrzHxfuUfVqiglnr3",
      "type": "rectangle",
      "x": 54.04422585727275,
      "y": 121832.18923454816,
      "width": 764.6164621148007,
      "height": 581.1086603908625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bnD",
      "roundness": null,
      "seed": 1796691585,
      "version": 59,
      "versionNonce": 127846319,
      "isDeleted": false,
