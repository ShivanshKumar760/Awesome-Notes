    {
      "id": "gL1x0hLMzxz9GUK1rRUU4",
      "type": "text",
      "x": -966.0996023213937,
      "y": 126160.2049319885,
      "width": 1243.633206932776,
      "height": 1125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bnN",
      "roundness": null,
      "seed": 2017252207,
      "version": 142,
      "versionNonce": 673203919,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767022140975,
      "link": null,
      "locked": false,
      "text": "1️⃣ Create a Custom Authentication Token\n\nThis represents WHAT kind of authentication you want.\n\nMyAuthToken.java\nimport org.springframework.security.authentication.AbstractAuthenticationToken;\nimport org.springframework.security.core.GrantedAuthority;\n\nimport java.util.Collection;\n\npublic class MyAuthToken extends AbstractAuthenticationToken {\n\n    private final Object principal;\n    private Object credentials;\n\n    // BEFORE authentication\n    public MyAuthToken(String username, String secret) {\n        super(null);\n        this.principal = username;\n        this.credentials = secret;\n        setAuthenticated(false);\n    }\n\n    // AFTER authentication\n    public MyAuthToken(Object principal,\n                       Collection<? extends GrantedAuthority> authorities) {\n        super(authorities);\n        this.principal = principal;\n        this.credentials = null;\n        setAuthenticated(true);\n    }\n\n    @Override\n    public Object getCredentials() {\n        return credentials;\n    }\n\n    @Override\n    public Object getPrincipal() {\n        return principal;\n    }\n}\n\n\n🔑 This is exactly how UsernamePasswordAuthenticationToken works internally.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1️⃣ Create a Custom Authentication Token\n\nThis represents WHAT kind of authentication you want.\n\nMyAuthToken.java\nimport org.springframework.security.authentication.AbstractAuthenticationToken;\nimport org.springframework.security.core.GrantedAuthority;\n\nimport java.util.Collection;\n\npublic class MyAuthToken extends AbstractAuthenticationToken {\n\n    private final Object principal;\n    private Object credentials;\n\n    // BEFORE authentication\n    public MyAuthToken(String username, String secret) {\n        super(null);\n        this.principal = username;\n        this.credentials = secret;\n        setAuthenticated(false);\n    }\n\n    // AFTER authentication\n    public MyAuthToken(Object principal,\n                       Collection<? extends GrantedAuthority> authorities) {\n        super(authorities);\n        this.principal = principal;\n        this.credentials = null;\n        setAuthenticated(true);\n    }\n\n    @Override\n    public Object getCredentials() {\n        return credentials;\n    }\n\n    @Override\n    public Object getPrincipal() {\n        return principal;\n    }\n}\n\n\n🔑 This is exactly how UsernamePasswordAuthenticationToken works internally.",
      "autoResize": false,
      "lineHeight": 1.25
    },
