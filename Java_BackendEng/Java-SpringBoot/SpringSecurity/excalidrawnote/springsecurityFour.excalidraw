      "seed": 204400591,
      "version": 277,
      "versionNonce": 1378027631,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767020442925,
      "link": null,
      "locked": false,
      "text": "Now let's see how the before and after authentication take \nplace that is why do we need AuthenticationManager and AuthenticationProvider\nbefore jwt token and why dont we need after jwt token validation",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now let's see how the before and after authentication take \nplace that is why do we need AuthenticationManager and AuthenticationProvider\nbefore jwt token and why dont we need after jwt token validation",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7Bo_Cz7myaR99aKEr2Rsn",
      "type": "text",
      "x": -452.937076758225,
      "y": 113928.76629959987,
      "width": 1147.2446954053178,
      "height": 455,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bmM",
      "roundness": null,
      "seed": 903613135,
      "version": 67,
      "versionNonce": 1774595361,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767020560571,
      "link": null,
      "locked": false,
      "text": "🧩 How Authentication Object Is Created (Even When You Don’t)\n\nCase 1: Username + Password\n\nSpring internally does:\n\nnew UsernamePasswordAuthenticationToken(username, password)\n\nThis happens inside:\n\nUsernamePasswordAuthenticationFilter\n\nYou NEVER write this manually.Let's understand this",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🧩 How Authentication Object Is Created (Even When You Don’t)\n\nCase 1: Username + Password\n\nSpring internally does:\n\nnew UsernamePasswordAuthenticationToken(username, password)\n\nThis happens inside:\n\nUsernamePasswordAuthenticationFilter\n\nYou NEVER write this manually.Let's understand this",
      "autoResize": false,
      "lineHeight": 1.25
    },
