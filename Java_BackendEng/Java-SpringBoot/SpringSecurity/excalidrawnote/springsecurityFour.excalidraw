    {
      "id": "kfXaNmVpsucwcOtdV2hXV",
      "type": "text",
      "x": -443.88419380864207,
      "y": 112259.10152583473,
      "width": 792,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bmI",
      "roundness": null,
      "seed": 1210009537,
      "version": 41,
      "versionNonce": 301192655,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767019291113,
      "link": null,
      "locked": false,
      "text": "5️⃣ Why other providers are NOT selected\n\nExample:\n\nOAuth provider:\nsupports(OAuth2LoginAuthenticationToken.class)\n\n\n❌ Your auth object is NOT that class\n\nJWT provider (if it existed):\nsupports(JwtAuthenticationToken.class)\n\n\n❌ Your auth object is NOT that class\n\n6️⃣ So WHY does DaoAuthenticationProvider exist at all?\n\nBecause Spring Boot auto-creates it only if:\n\nUserDetailsService exists\n\nPasswordEncoder exists\n\nSpring says:\n\n“Since you want username/password auth, I’ll register a provider for it.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5️⃣ Why other providers are NOT selected\n\nExample:\n\nOAuth provider:\nsupports(OAuth2LoginAuthenticationToken.class)\n\n\n❌ Your auth object is NOT that class\n\nJWT provider (if it existed):\nsupports(JwtAuthenticationToken.class)\n\n\n❌ Your auth object is NOT that class\n\n6️⃣ So WHY does DaoAuthenticationProvider exist at all?\n\nBecause Spring Boot auto-creates it only if:\n\nUserDetailsService exists\n\nPasswordEncoder exists\n\nSpring says:\n\n“Since you want username/password auth, I’ll register a provider for it.",
      "autoResize": true,
      "lineHeight": 1.25
    },
