    {
      "id": "iZ8sE5tsKoUqcdFHIGAgz",
      "type": "text",
      "x": -385.9812331365499,
      "y": 103905.93964798353,
      "width": 621.4609375,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
