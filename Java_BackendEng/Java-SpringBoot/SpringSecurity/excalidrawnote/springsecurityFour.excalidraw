    {
      "id": "XbNny5utfPKoVdaw1jo5p",
      "type": "text",
      "x": -339.45616197625645,
      "y": 97695.31665805494,
      "width": 401.4609375,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
