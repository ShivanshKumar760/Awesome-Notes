    {
      "id": "hP2KGYPPNOLWKoLsyTEce",
      "type": "text",
      "x": 482.25271341479595,
      "y": 5508.583514910126,
      "width": 771.5642821743427,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bf1",
