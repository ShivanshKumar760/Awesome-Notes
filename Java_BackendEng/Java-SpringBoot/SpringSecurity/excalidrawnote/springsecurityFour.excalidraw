    {
      "id": "XgipJ_oyZrMrvlmZa7Yew",
      "type": "text",
      "x": 527.5403536767745,
      "y": 12853.440595923437,
      "width": 1674.7958286960957,
      "height": 563.5413593174264,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bfR",
      "roundness": null,
      "seed": 1280995311,
      "version": 138,
      "versionNonce": 562600161,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766911977360,
      "link": null,
      "locked": false,
      "text": "The Default Behavior of Spring Security :\n\n1Authentication: Spring Security defaults to form-based authentication and provides a basic login page. HTTP Basic\nAuthentication is used for REST APIs.\n\n2.In-Memory User: An in-memory user with the username user and a generated password is created by default.\nAuthorization: All requests are secured by default, with access allowed only to login, logout, and error pages unless\nexplicitly configured.\n\n3.CSRF Protection: CSRF protection is enabled by default for state-changing requests.\n\n4.Session Management: Sessions are managed with session fixation protection and a single session per user by default.\n\n5.Password Encoding: Passwords are encoded using BCryptPasswordEncoder.\n\n6.Logout: A default logout endpoint is provided, which invalidates the session and redirects to the login page.\n\n7.Access Denied Handling: Unauthorized access attempts result in a 403 error or redirect to an access denied page",
      "fontSize": 25.046282636330066,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Default Behavior of Spring Security :\n\n1Authentication: Spring Security defaults to form-based authentication and provides a basic login page. HTTP Basic Authentication is used for REST APIs.\n\n2.In-Memory User: An in-memory user with the username user and a generated password is created by default.\nAuthorization: All requests are secured by default, with access allowed only to login, logout, and error pages unless explicitly configured.\n\n3.CSRF Protection: CSRF protection is enabled by default for state-changing requests.\n\n4.Session Management: Sessions are managed with session fixation protection and a single session per user by default.\n\n5.Password Encoding: Passwords are encoded using BCryptPasswordEncoder.\n\n6.Logout: A default logout endpoint is provided, which invalidates the session and redirects to the login page.\n\n7.Access Denied Handling: Unauthorized access attempts result in a 403 error or redirect to an access denied page",
      "autoResize": false,
      "lineHeight": 1.25
    },
