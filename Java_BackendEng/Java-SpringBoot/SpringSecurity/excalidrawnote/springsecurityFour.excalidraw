    {
      "id": "7A1vgCDSflxwgyWFRrvhx",
      "type": "text",
      "x": 60.16097200026002,
      "y": 121707.81162588202,
      "width": 792,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
