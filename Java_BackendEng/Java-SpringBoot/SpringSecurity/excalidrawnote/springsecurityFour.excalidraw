    {
      "id": "Qqas_c064cR0U3JJ839n6",
      "type": "text",
      "x": -327.91388200082065,
      "y": 95323.32621517422,
      "width": 649,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
