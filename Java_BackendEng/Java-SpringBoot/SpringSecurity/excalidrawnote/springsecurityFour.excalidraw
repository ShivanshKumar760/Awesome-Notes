      "seed": 832076609,
      "version": 164,
      "versionNonce": 1060537761,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766945630877,
      "link": null,
      "locked": false,
      "text": "7️⃣ Then what authenticates requests?\n👉 JwtFilter\njwtUtil.validateToken(token);\n\n\nThis replaces AuthenticationManager.\n\nJwtFilter does:\n1. Extract token\n2. Validate token\n3. Extract username\n4. Load UserDetails\n5. Create Authentication object\n6. Put it into SecurityContext",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "7️⃣ Then what authenticates requests?\n👉 JwtFilter\njwtUtil.validateToken(token);\n\n\nThis replaces AuthenticationManager.\n\nJwtFilter does:\n1. Extract token\n2. Validate token\n3. Extract username\n4. Load UserDetails\n5. Create Authentication object\n6. Put it into SecurityContext",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "7Le_zejZsm7S8e0hOOLLx",
      "type": "rectangle",
      "x": -340.40883956944134,
