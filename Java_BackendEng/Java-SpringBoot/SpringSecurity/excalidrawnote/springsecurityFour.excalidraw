    {
      "id": "cRpEXWNMkDXFZi944RJ85",
      "type": "text",
      "x": -416.57099544907135,
      "y": 108212.27119335503,
      "width": 1267.19921875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
