      "link": null,
      "locked": false,
      "text": "com.example.todoapi\n├── config\n│   └── SecurityConfig.java\n├── controller\n│   ├── AuthController.java\n│   └── TodoController.java\n├── filter\n│   └── JwtFilter.java\n├── model\n│   ├── UserEntity.java\n│   └── TodoEntity.java\n├── repository\n│   ├── UserRepository.java\n│   └── TodoRepository.java\n├── security\n│   └── CustomUserDetailsService.java\n├── util\n│   └── JwtUtil.java\n└── TodoApiApplication.java",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "com.example.todoapi\n├── config\n│   └── SecurityConfig.java\n├── controller\n│   ├── AuthController.java\n│   └── TodoController.java\n├── filter\n│   └── JwtFilter.java\n├── model\n│   ├── UserEntity.java\n│   └── TodoEntity.java\n├── repository\n│   ├── UserRepository.java\n│   └── TodoRepository.java\n├── security\n│   └── CustomUserDetailsService.java\n├── util\n│   └── JwtUtil.java\n└── TodoApiApplication.java",
