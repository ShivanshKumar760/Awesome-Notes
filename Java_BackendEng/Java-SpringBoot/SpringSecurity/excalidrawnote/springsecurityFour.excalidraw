    {
      "id": "Rt7SGtsPB5v7HVDeFkhHo",
      "type": "text",
      "x": -327.47421505430873,
      "y": 87540.81140079634,
      "width": 982.2765867549692,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
