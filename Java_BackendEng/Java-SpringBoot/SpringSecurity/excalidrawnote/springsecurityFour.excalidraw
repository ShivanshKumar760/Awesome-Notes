    {
      "id": "khkLvKy2eCKZtDEeZ5wgP",
      "type": "text",
      "x": 496.025640091697,
      "y": 10340.168187439916,
      "width": 1098.9585922797478,
      "height": 233.27052395839206,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bfJ",
      "roundness": null,
      "seed": 2070767503,
      "version": 207,
      "versionNonce": 844868065,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766911587759,
      "link": null,
      "locked": false,
      "text": "Internal Working of Spring Security:\nIn a Spring Boot application, SecurityFilterAutoConfiguration\nautomatically registers the DelegatingFilterProxy filter with the name\nspringSecurityFilterChain. Once the request reaches to\nDelegatingFilterProxy, Spring delegates the processing to FilterChainProxy\nbean that utilizes the SecurityFilterChain to execute the list of all\nfilters to be invoked for the current request.",
      "fontSize": 26.659488452387684,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Internal Working of Spring Security:\nIn a Spring Boot application, SecurityFilterAutoConfiguration automatically registers the DelegatingFilterProxy filter with the name springSecurityFilterChain. Once the request reaches to DelegatingFilterProxy, Spring delegates the processing to FilterChainProxy bean that utilizes the SecurityFilterChain to execute the list of all filters to be invoked for the current request.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "eUZsOIchXUunnpkVKfzSE",
      "type": "rectangle",
      "x": 472.080312991936,
      "y": 10328.048283182801,
      "width": 1123.3970943845502,
      "height": 246.65396481708012,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
