      "updated": 1766949521409,
      "link": null,
      "locked": false,
      "text": "🧠 Core Idea\n\nSpring Security follows this rule:\n\n“Tell me WHAT you support, and I’ll choose the provider for you.”",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🧠 Core Idea\n\nSpring Security follows this rule:\n\n“Tell me WHAT you support, and I’ll choose the provider for you.”",
      "autoResize": true,
      "lineHeight": 1.25
    },
