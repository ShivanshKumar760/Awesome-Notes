    {
      "id": "5luCBDrtjQ1BgkJoZIp4v",
      "type": "text",
      "x": -439.72591764895867,
      "y": 110853.72138660838,
      "width": 770,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bmD",
      "roundness": null,
      "seed": 1396653281,
      "version": 54,
      "versionNonce": 1851709007,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767019218113,
      "link": null,
      "locked": false,
      "text": "3️⃣ ProviderManager asks EACH provider the SAME question\n\nInternally (simplified):\n\nfor (AuthenticationProvider provider : providers) {\n    if (provider.supports(auth.getClass())) {\n        return provider.authenticate(auth);\n    }\n}\n\n\n🔴 This is the only decision point\n\n4️⃣ DaoAuthenticationProvider’s supports() logic\n@Override\npublic boolean supports(Class<?> authentication) {\n    return UsernamePasswordAuthenticationToken.class\n            .isAssignableFrom(authentication);\n}\n\n\nThis literally means:\n\n“If the Authentication object is a UsernamePasswordAuthenticationToken\n(or subclass), I can handle it.”\n\n✔ TRUE → DaoAuthenticationProvider is selected",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3️⃣ ProviderManager asks EACH provider the SAME question\n\nInternally (simplified):\n\nfor (AuthenticationProvider provider : providers) {\n    if (provider.supports(auth.getClass())) {\n        return provider.authenticate(auth);\n    }\n}\n\n\n🔴 This is the only decision point\n\n4️⃣ DaoAuthenticationProvider’s supports() logic\n@Override\npublic boolean supports(Class<?> authentication) {\n    return UsernamePasswordAuthenticationToken.class\n            .isAssignableFrom(authentication);\n}\n\n\nThis literally means:\n\n“If the Authentication object is a UsernamePasswordAuthenticationToken (or subclass), I can handle it.”\n\n✔ TRUE → DaoAuthenticationProvider is selected",
      "autoResize": false,
      "lineHeight": 1.25
    },
