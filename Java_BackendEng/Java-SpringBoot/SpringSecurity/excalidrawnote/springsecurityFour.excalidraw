    {
      "id": "6UZzQgkRKViADpGdYOut8",
      "type": "text",
      "x": 460.049581690173,
      "y": 36745.50991504677,
      "width": 840.6865861637098,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
