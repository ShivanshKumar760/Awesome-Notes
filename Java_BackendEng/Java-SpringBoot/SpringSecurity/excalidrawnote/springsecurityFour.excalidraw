    {
      "id": "0oBFW8agYnemJ9Zw1Mx-e",
      "type": "text",
      "x": -972.581116552027,
      "y": 135871.66647112404,
      "width": 605,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
