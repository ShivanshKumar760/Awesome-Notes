      "boundElements": [],
      "updated": 1766918697690,
      "link": null,
      "locked": false,
      "text": "🔥 Filter Order Matters A LOT (middleware matters a lot)\n\nWrong order = security broken.\n\nExample:\n\n.addFilterBefore(jwtFilter, UsernamePasswordAuthenticationFilter.class)\n\n\nMeans:\n\nRun JWT filter before username-password filter",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🔥 Filter Order Matters A LOT (middleware matters a lot)\n\nWrong order = security broken.\n\nExample:\n\n.addFilterBefore(jwtFilter, UsernamePasswordAuthenticationFilter.class)\n\n\nMeans:\n\nRun JWT filter before username-password filter",
      "autoResize": true,
      "lineHeight": 1.25
    },
