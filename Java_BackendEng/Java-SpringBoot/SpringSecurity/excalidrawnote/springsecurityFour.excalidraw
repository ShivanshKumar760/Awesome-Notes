      "seed": 988127649,
      "version": 60,
      "versionNonce": 961699407,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767022793553,
      "link": null,
      "locked": false,
      "text": "3️⃣ Use It in Controller (No wiring needed!)\nAuthController.java\n@RestController\n@RequestMapping(\"/auth\")\npublic class AuthController {\n\n    private final AuthenticationManager authenticationManager;\n\n    public AuthController(AuthenticationManager authenticationManager) {\n        this.authenticationManager = authenticationManager;\n    }\n\n    @PostMapping(\"/login\")\n    public String login(@RequestBody LoginRequest req) {\n\n        Authentication auth = authenticationManager.authenticate(\n                new MyAuthToken(req.getUsername(), req.getSecret())\n        );\n\n        return \"Authenticated as: \" + auth.getPrincipal();\n    }\n}\n\n\n🚨 Notice\n\nYou did NOT register provider\n\nYou did NOT select provider\n\nSpring did everything",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3️⃣ Use It in Controller (No wiring needed!)\nAuthController.java\n@RestController\n@RequestMapping(\"/auth\")\npublic class AuthController {\n\n    private final AuthenticationManager authenticationManager;\n\n    public AuthController(AuthenticationManager authenticationManager) {\n        this.authenticationManager = authenticationManager;\n    }\n\n    @PostMapping(\"/login\")\n    public String login(@RequestBody LoginRequest req) {\n\n        Authentication auth = authenticationManager.authenticate(\n                new MyAuthToken(req.getUsername(), req.getSecret())\n        );\n\n        return \"Authenticated as: \" + auth.getPrincipal();\n    }\n}\n\n\n🚨 Notice\n\nYou did NOT register provider\n\nYou did NOT select provider\n\nSpring did everything",
      "autoResize": true,
      "lineHeight": 1.25
    },
