    {
      "id": "p-n5X_WPEZXWJDYZTiKwD",
      "type": "text",
      "x": -317.96267339599854,
      "y": 83154.79411499591,
      "width": 1046.608754939445,
      "height": 945,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bjo",
      "roundness": null,
      "seed": 694272129,
      "version": 112,
      "versionNonce": 2055452719,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766945393404,
      "link": null,
      "locked": false,
      "text": "DaoAuthenticationProvider does this:\n1. loadUserByUsername(username)\n2. passwordEncoder.matches(raw, encoded)\n3. return authenticated Authentication\n\n4️⃣ FULL LOGIN FLOW (REAL EXECUTION)\nAuthController.login()\n│\n│  UsernamePasswordAuthenticationToken (username, password)\n▼\nAuthenticationManager.authenticate()\n│\n│  finds provider that supports UsernamePasswordAuthenticationToken\n▼\nDaoAuthenticationProvider\n│\n│  calls CustomUserDetailsService.loadUserByUsername()\n│\n│  compares passwords using BCrypt\n▼\nAuthenticated Authentication returned\n\n\nAt this point:\n\n✔ User is authenticated\n✔ JWT can be generated",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DaoAuthenticationProvider does this:\n1. loadUserByUsername(username)\n2. passwordEncoder.matches(raw, encoded)\n3. return authenticated Authentication\n\n4️⃣ FULL LOGIN FLOW (REAL EXECUTION)\nAuthController.login()\n│\n│  UsernamePasswordAuthenticationToken (username, password)\n▼\nAuthenticationManager.authenticate()\n│\n│  finds provider that supports UsernamePasswordAuthenticationToken\n▼\nDaoAuthenticationProvider\n│\n│  calls CustomUserDetailsService.loadUserByUsername()\n│\n│  compares passwords using BCrypt\n▼\nAuthenticated Authentication returned\n\n\nAt this point:\n\n✔ User is authenticated\n✔ JWT can be generated",
      "autoResize": false,
      "lineHeight": 1.25
    },
