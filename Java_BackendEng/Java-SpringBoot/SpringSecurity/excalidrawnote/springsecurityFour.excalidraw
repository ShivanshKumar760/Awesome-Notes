      "locked": false,
      "text": "4️⃣ Your Todo + JWT app (REAL CASE)\nYou have:\n@Bean\nUserDetailsService userDetailsService()\n\n@Bean\nPasswordEncoder passwordEncoder()",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4️⃣ Your Todo + JWT app (REAL CASE)\nYou have:\n@Bean\nUserDetailsService userDetailsService()\n\n@Bean\nPasswordEncoder passwordEncoder()",
      "autoResize": true,
      "lineHeight": 1.25
    },
