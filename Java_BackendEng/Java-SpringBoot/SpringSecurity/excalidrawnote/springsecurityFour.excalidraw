    {
      "id": "JKcRtoJ9vlvOxmZHZX_JQ",
      "type": "text",
      "x": 472.73446642056365,
      "y": 28398.40050462663,
      "width": 781,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
