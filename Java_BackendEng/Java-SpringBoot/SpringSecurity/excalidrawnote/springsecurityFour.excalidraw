      "seed": 1161036289,
      "version": 41,
      "versionNonce": 268574607,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767016803803,
      "link": null,
      "locked": false,
      "text": "5️⃣ Why DaoAuthenticationProvider is chosen\n\nBecause during login you create:\n\nnew UsernamePasswordAuthenticationToken(username, password)\n\n\nDaoAuthenticationProvider declares:\n\nsupports(UsernamePasswordAuthenticationToken.class) → true\n\n\n✔ Match found\n✔ Provider selected\n✔ Authentication happens",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5️⃣ Why DaoAuthenticationProvider is chosen\n\nBecause during login you create:\n\nnew UsernamePasswordAuthenticationToken(username, password)\n\n\nDaoAuthenticationProvider declares:\n\nsupports(UsernamePasswordAuthenticationToken.class) → true\n\n\n✔ Match found\n✔ Provider selected\n✔ Authentication happens",
      "autoResize": true,
      "lineHeight": 1.25
    },
