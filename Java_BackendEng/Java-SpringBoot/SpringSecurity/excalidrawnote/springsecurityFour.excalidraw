    {
      "id": "jNWPbxEabKTKsb3In9e2S",
      "type": "text",
      "x": -310.3394229838867,
      "y": 91487.79547693797,
      "width": 737,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
