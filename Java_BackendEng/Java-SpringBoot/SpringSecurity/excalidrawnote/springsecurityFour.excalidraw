      "text": "🧠 One-line rule (MEMORIZE THIS)\n\nAuthenticationManager is for login.\nJWT Filter is for every request.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🧠 One-line rule (MEMORIZE THIS)\n\nAuthenticationManager is for login.\nJWT Filter is for every request.",
      "autoResize": true,
      "lineHeight": 1.25
    },
