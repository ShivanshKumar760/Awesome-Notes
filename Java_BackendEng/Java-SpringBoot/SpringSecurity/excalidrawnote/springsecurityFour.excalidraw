    {
      "id": "aDfE9tuGTXWu3y1Or8X8D",
      "type": "text",
      "x": -319.0588754357278,
      "y": 95014.43606093079,
      "width": 759,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bkd",
      "roundness": null,
      "seed": 313911855,
      "version": 40,
      "versionNonce": 1448874849,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767016746138,
      "link": null,
      "locked": false,
      "text": "Spring Boot auto-config does this behind the scenes:\nDaoAuthenticationProvider provider = new DaoAuthenticationProvider();\nprovider.setUserDetailsService(userDetailsService);\nprovider.setPasswordEncoder(passwordEncoder);\n\n\nThen registers it into:\n\nProviderManager (AuthenticationManager)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Spring Boot auto-config does this behind the scenes:\nDaoAuthenticationProvider provider = new DaoAuthenticationProvider();\nprovider.setUserDetailsService(userDetailsService);\nprovider.setPasswordEncoder(passwordEncoder);\n\n\nThen registers it into:\n\nProviderManager (AuthenticationManager)",
      "autoResize": true,
      "lineHeight": 1.25
    },
