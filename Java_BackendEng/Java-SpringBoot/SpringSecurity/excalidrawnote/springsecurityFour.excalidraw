      "updated": 1767017312269,
      "link": null,
      "locked": false,
      "text": "This does not need AuthenticationManager\ncause DaoAuthenticatonProvider already\nauthenticated the Username and credential\nafter which jwt token was genrated\nand then that token was validated\nso we dont require AuthenticationProvider",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This does not need AuthenticationManager\ncause DaoAuthenticatonProvider already\nauthenticated the Username and credential\nafter which jwt token was genrated\nand then that token was validated\nso we dont require AuthenticationProvider",
      "autoResize": true,
      "lineHeight": 1.25
    },
