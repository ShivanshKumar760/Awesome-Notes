      "seed": 1925873409,
      "version": 67,
      "versionNonce": 396680655,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766949470345,
      "link": null,
      "locked": false,
      "text": "✅ Short Answer (one line)\n\nSpring Security auto-registers AuthenticationProviders based on the\nbeans you define (UserDetailsService, PasswordEncoder, OAuth beans,\netc.)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "✅ Short Answer (one line)\n\nSpring Security auto-registers AuthenticationProviders based on the beans you define (UserDetailsService, PasswordEncoder, OAuth beans, etc.)",
      "autoResize": false,
      "lineHeight": 1.25
    },
