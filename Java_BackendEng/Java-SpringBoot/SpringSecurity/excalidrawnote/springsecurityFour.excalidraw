    {
      "id": "q-D9QMuR9CrXhetaEEFQQ",
      "type": "text",
      "x": -388.3479454499153,
      "y": 105123.13290210535,
      "width": 649,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bls",
