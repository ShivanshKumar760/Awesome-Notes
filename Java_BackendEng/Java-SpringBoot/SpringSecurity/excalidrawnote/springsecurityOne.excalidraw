      "link": null,
      "locked": false,
      "text": "📦 Authentication Object (Important)\n\nSpring uses:\n\nAuthentication auth\n\n\nThis object contains:\n\nusername\n\nroles\n\nauthentication status\n\nIt is stored here 👇\n\nSecurityContextHolder.getContext().getAuthentication();",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "📦 Authentication Object (Important)\n\nSpring uses:\n\nAuthentication auth\n\n\nThis object contains:\n\nusername\n\nroles\n\nauthentication status\n\nIt is stored here 👇\n\nSecurityContextHolder.getContext().getAuthentication();",
      "autoResize": true,
      "lineHeight": 1.25
    },
