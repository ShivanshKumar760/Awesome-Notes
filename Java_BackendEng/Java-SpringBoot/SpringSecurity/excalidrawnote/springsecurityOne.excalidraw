      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "✅ UserDetails → YES, it comes with Spring Security\n❌ Your User (Entity / Model) → NO, it does NOT come with Spring Security\n\nThey are two different things.",
      "autoResize": false,
      "lineHeight": 1.25
    },
