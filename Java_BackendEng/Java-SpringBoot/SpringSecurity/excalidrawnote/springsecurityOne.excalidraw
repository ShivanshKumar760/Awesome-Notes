    {
      "id": "1rzBQXNFRlbia5-i3gFKK",
      "type": "text",
      "x": 463.25798820550983,
      "y": 31371.31305214307,
      "width": 922.9210659847422,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
