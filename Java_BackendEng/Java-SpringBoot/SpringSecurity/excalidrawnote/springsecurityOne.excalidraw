    {
      "id": "ZTmRet4Z1ms6eClC7y3_a",
      "type": "text",
      "x": 57.88079694021826,
      "y": 71376.28442086751,
      "width": 933.3884087227693,
      "height": 1082.3232967593785,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bj5",
      "roundness": null,
      "seed": 1276864193,
      "version": 108,
      "versionNonce": 1246543073,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1766926286424,
      "link": null,
      "locked": false,
      "text": "4️⃣ FULL LOGIN FLOW (REAL EXECUTION)\nAuthController.login()\n│\n│  UsernamePasswordAuthenticationToken (username,\npassword)\n▼\nAuthenticationManager.authenticate()\n│\n│  finds provider that supports\nUsernamePasswordAuthenticationToken\n▼\nDaoAuthenticationProvider\n│\n│  calls\nCustomUserDetailsService.loadUserByUsername()\n│\n│  compares passwords using BCrypt\n▼\nAuthenticated Authentication returned\n\n\nAt this point:\n\n✔ User is authenticated\n✔ JWT can be generated",
      "fontSize": 34.63434549630011,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4️⃣ FULL LOGIN FLOW (REAL EXECUTION)\nAuthController.login()\n│\n│  UsernamePasswordAuthenticationToken (username, password)\n▼\nAuthenticationManager.authenticate()\n│\n│  finds provider that supports UsernamePasswordAuthenticationToken\n▼\nDaoAuthenticationProvider\n│\n│  calls CustomUserDetailsService.loadUserByUsername()\n│\n│  compares passwords using BCrypt\n▼\nAuthenticated Authentication returned\n\n\nAt this point:\n\n✔ User is authenticated\n✔ JWT can be generated",
      "autoResize": false,
      "lineHeight": 1.25
    },
