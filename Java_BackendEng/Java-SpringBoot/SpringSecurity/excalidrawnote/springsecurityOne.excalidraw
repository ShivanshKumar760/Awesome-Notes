    {
      "id": "bov-LJPZ57lhYW32zNV-X",
      "type": "text",
      "x": 472.734542783331,
      "y": 29837.765657702766,
      "width": 781,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
