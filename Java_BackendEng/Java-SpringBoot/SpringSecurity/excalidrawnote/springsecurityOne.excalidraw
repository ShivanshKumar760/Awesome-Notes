    {
      "id": "yY2iY8euU9O7-ff8AMHg3",
      "type": "text",
      "x": 478.94745362430444,
      "y": 24385.810567613873,
      "width": 528,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
