    {
      "id": "U-X8-ce5RxNMGO2gmd4od",
      "type": "text",
      "x": 437.4427460075415,
      "y": 43558.324651889445,
      "width": 759,
      "height": 650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
