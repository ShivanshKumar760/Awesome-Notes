      "link": null,
      "locked": false,
      "text": "Visualizing the Security Flow \nSpring Security integrates seamlessly with the application's front controller\nand \n\nintercepts requests through filters: \n● Filter Chain: Requests pass through multiple security filters before reaching \nthe controller.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Visualizing the Security Flow \nSpring Security integrates seamlessly with the application's front controller and \n\nintercepts requests through filters: \n● Filter Chain: Requests pass through multiple security filters before reaching \nthe controller.",
      "autoResize": false,
      "lineHeight": 1.25
    },
