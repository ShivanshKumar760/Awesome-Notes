    {
      "id": "6UZzQgkRKViADpGdYOut8",
      "type": "text",
      "x": 460.049581690173,
      "y": 36745.50991504677,
      "width": 840.6865861637098,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bhA",
      "roundness": null,
      "seed": 443990145,
      "version": 103,
      "versionNonce": 438028015,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1766920048264,
      "link": null,
      "locked": false,
      "text": "6️⃣ Why Spring Security Uses Filters\n\nSpring Security is NOT magic\nIt is just a BIG chain of filters\n\nExamples:\n\nUsernamePasswordAuthenticationFilter\n\nJwtAuthenticationFilter\n\nSecurityContextPersistenceFilter\n\nExceptionTranslationFilter\n\nEach one:\n\ndo something\nchain.doFilter()\ndo something after",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "6️⃣ Why Spring Security Uses Filters\n\nSpring Security is NOT magic\nIt is just a BIG chain of filters\n\nExamples:\n\nUsernamePasswordAuthenticationFilter\n\nJwtAuthenticationFilter\n\nSecurityContextPersistenceFilter\n\nExceptionTranslationFilter\n\nEach one:\n\ndo something\nchain.doFilter()\ndo something after",
      "autoResize": false,
      "lineHeight": 1.25
    },
