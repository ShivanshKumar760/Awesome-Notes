    {
      "id": "TkOZhZKUFPAfsORMj_nqt",
      "type": "text",
      "x": 261.89605801048776,
      "y": 52292.68406013737,
      "width": 1277.2696989423182,
      "height": 945,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
