      "text": "i)Creating Users table -class",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "i)Creating Users table -class",
      "autoResize": true,
