      "index": "bLF",
      "roundness": null,
      "seed": 550801377,
      "version": 46,
      "versionNonce": 1079415375,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763205533699,
      "link": null,
      "locked": false,
      "text": "Example Use Case\n\nA Department has many Employees\nEach Employee belongs to one Department",
