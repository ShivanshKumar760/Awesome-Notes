    {
      "id": "Fl1-Xd6m8Ceku3R1dOKOi",
      "type": "text",
      "x": -439.70554871400566,
      "y": 24922.042127558274,
      "width": 715,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHV",
