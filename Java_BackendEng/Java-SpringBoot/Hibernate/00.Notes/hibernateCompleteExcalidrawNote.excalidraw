      "boundElements": null,
      "updated": 1763213912840,
      "link": null,
      "locked": false,
      "text": "now here \nas u can \nsee both apartment\nid and user id\nare repeating \nagain and again\nso we cant use either table to \nstore foreign key cause that table\nweather its apartments table or\nusers table there own id will repeat two\nso we wont have a primary key so we \nwill make a seprate table which will \nhold society id and user_id and user there\ncomposite key as primary key\n\nso we will have 3 tables",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "now here \nas u can \nsee both apartment\nid and user id\nare repeating \nagain and again\nso we cant use either table to \nstore foreign key cause that table\nweather its apartments table or\nusers table there own id will repeat two\nso we wont have a primary key so we \nwill make a seprate table which will \nhold society id and user_id and user there\ncomposite key as primary key\n\nso we will have 3 tables",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bwatWiF6i5sh4SMCb7YEO",
