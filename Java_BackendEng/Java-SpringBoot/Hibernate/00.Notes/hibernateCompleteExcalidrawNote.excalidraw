    {
      "id": "DFBSsNy3hdGsYcz40tqi3",
      "type": "text",
      "x": -775.3690203963097,
      "y": 74054.63079165551,
      "width": 766.0121121491395,
      "height": 1106.3560552879949,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNw",
      "roundness": null,
      "seed": 2101115951,
      "version": 114,
      "versionNonce": 965865441,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763214988772,
      "link": null,
      "locked": false,
      "text": "package org.example;\n\nimport jakarta.persistence.Entity;\nimport jakarta.persistence.Id;\nimport jakarta.persistence.ManyToMany;\n\nimport java.util.List;\n\n@Entity\npublic class Members {\n    @Id\n    private int memid;\n    private String memberName;\n    @ManyToMany\n    private List<Societies> societies;\n\n    public int getMemid() {\n        return memid;\n    }\n\n    public void setMemid(int memid) {\n        this.memid = memid;\n    }\n\n    public String getMemberName() {\n        return memberName;\n    }\n\n    public void setMemberName(String memberName) {\n        this.memberName = memberName;\n    }\n\n    public List<Societies> getSocieties() {\n        return societies;\n    }\n\n    public void setSocieties(List<Societies> societies) {\n        this.societies = societies;\n    }\n\n\n    @Override\n    public String toString() {\n        return \"Members{\" +\n                \"memid=\" + memid +\n                \", memberName='\" + memberName + '\\'' +\n                \", societies=\" + societies +\n                '}';\n    }\n}",
      "fontSize": 17.70169688460792,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "package org.example;\n\nimport jakarta.persistence.Entity;\nimport jakarta.persistence.Id;\nimport jakarta.persistence.ManyToMany;\n\nimport java.util.List;\n\n@Entity\npublic class Members {\n    @Id\n    private int memid;\n    private String memberName;\n    @ManyToMany\n    private List<Societies> societies;\n\n    public int getMemid() {\n        return memid;\n    }\n\n    public void setMemid(int memid) {\n        this.memid = memid;\n    }\n\n    public String getMemberName() {\n        return memberName;\n    }\n\n    public void setMemberName(String memberName) {\n        this.memberName = memberName;\n    }\n\n    public List<Societies> getSocieties() {\n        return societies;\n    }\n\n    public void setSocieties(List<Societies> societies) {\n        this.societies = societies;\n    }\n\n\n    @Override\n    public String toString() {\n        return \"Members{\" +\n                \"memid=\" + memid +\n                \", memberName='\" + memberName + '\\'' +\n                \", societies=\" + societies +\n                '}';\n    }\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
