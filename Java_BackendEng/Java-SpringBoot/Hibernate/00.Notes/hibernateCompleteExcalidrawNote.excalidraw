      "seed": 1054775727,
      "version": 124,
      "versionNonce": 2129836463,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763130482785,
      "link": null,
      "locked": false,
      "text": "@Entity                          // Mark class\nas entity\n@Table(name = \"users\")          // Specify\ntable name\n\n@Id                             // Primary key\n@GeneratedValue(strategy =\nGenerationType.IDENTITY)  // Auto-increment\n@GeneratedValue(strategy = GenerationType.AUTO)\n// Hibernate decides\n@GeneratedValue(strategy =\nGenerationType.SEQUENCE)  // Use sequence\n@GeneratedValue(strategy = GenerationType.UUID)\n// Generate UUID\n\n@Column(name = \"user_name\")     // Column name\n@Column(nullable = false)       // NOT NULL\n@Column(unique = true)          // UNIQUE\nconstraint\n@Column(length = 100)           // VARCHAR(100)\n@Column(updatable = false)      // Cannot be\nupdated\n\n@Temporal(TemporalType.DATE)    // For\njava.util.Date (DATE only)\n@Temporal(TemporalType.TIME)    // For time\nonly\n@Temporal(TemporalType.TIMESTAMP) // For date\nand time\n\n@Transient                      // Don't\npersist this field\n\n@Enumerated(EnumType.STRING)    // Store enum\nas string\n@Enumerated(EnumType.ORDINAL)   // Store enum\nas number\n\n@Lob                            // Large object\n(BLOB/CLOB)",
      "fontSize": 15.735830067801578,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "@Entity                          // Mark class as entity\n@Table(name = \"users\")          // Specify table name\n\n@Id                             // Primary key\n@GeneratedValue(strategy = GenerationType.IDENTITY)  // Auto-increment\n@GeneratedValue(strategy = GenerationType.AUTO)      // Hibernate decides\n@GeneratedValue(strategy = GenerationType.SEQUENCE)  // Use sequence\n@GeneratedValue(strategy = GenerationType.UUID)      // Generate UUID\n\n@Column(name = \"user_name\")     // Column name\n@Column(nullable = false)       // NOT NULL\n@Column(unique = true)          // UNIQUE constraint\n@Column(length = 100)           // VARCHAR(100)\n@Column(updatable = false)      // Cannot be updated\n\n@Temporal(TemporalType.DATE)    // For java.util.Date (DATE only)\n@Temporal(TemporalType.TIME)    // For time only\n@Temporal(TemporalType.TIMESTAMP) // For date and time\n\n@Transient                      // Don't persist this field\n\n@Enumerated(EnumType.STRING)    // Store enum as string\n@Enumerated(EnumType.ORDINAL)   // Store enum as number\n\n@Lob                            // Large object (BLOB/CLOB)",
      "autoResize": false,
      "lineHeight": 1.25
    },
