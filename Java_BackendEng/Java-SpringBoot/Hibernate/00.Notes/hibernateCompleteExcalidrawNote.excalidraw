      "index": "bG2",
      "roundness": null,
      "seed": 820729335,
      "version": 52,
      "versionNonce": 1634896281,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762612905813,
      "link": null,
      "locked": false,
      "text": "// Load from hibernate.cfg.xml\nConfiguration config = new Configuration().configure();\nSessionFactory sf = config.buildSessionFactory();",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Load from hibernate.cfg.xml\nConfiguration config = new Configuration().configure();\nSessionFactory sf = config.buildSessionFactory();",
      "autoResize": true,
      "lineHeight": 1.25
    },
