    {
      "id": "0l0E-sv80J_-0Rzf-xnE3",
      "type": "text",
      "x": 254.25593678302903,
      "y": 54853.81558325947,
      "width": 561,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bLB",
      "roundness": null,
      "seed": 447753025,
      "version": 292,
      "versionNonce": 1288006095,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763205516123,
      "link": null,
      "locked": false,
      "text": "Now here one employee can belong to\none department but one department can have\nmany employee\n\n\nso from Employee perspective Many to one(Many \nemployee to one department) and from department\nperspective its One to Many(one Department  to many\nemployee)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now here one employee can belong to\none department but one department can have\nmany employee\n\n\nso from Employee perspective Many to one(Many \nemployee to one department) and from department\nperspective its One to Many(one Department  to many\nemployee)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nlXLl2Y6ZJ0bbq2bs_MnO",
      "type": "text",
      "x": -407.88292147873756,
      "y": 55115.18597366813,
      "width": 429,
