    {
      "id": "wp7o9C9_Rkvg37K23Fu25",
      "type": "text",
      "x": -429.49675751006566,
      "y": 24394.24728407642,
      "width": 594,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
