    {
      "id": "FQ0yjkL130vYRzXsHBH7e",
      "type": "text",
      "x": -408.0234647990822,
      "y": 52766.71732705517,
      "width": 946,
      "height": 775,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
