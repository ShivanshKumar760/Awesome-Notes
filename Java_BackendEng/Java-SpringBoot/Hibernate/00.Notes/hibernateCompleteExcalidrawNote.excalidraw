      "link": null,
      "locked": false,
      "text": "Inserting Data \n\nimport java.sql.*;\n\npublic class InsertDataExample {\n    public static void main(String[] args) {\n        String url = \"jdbc:mysql://localhost:3306/testdb\";\n        String username = \"root\";\n        String password = \"your_password\";\n        \n        // Using PreparedStatement (recommended - prevents SQL injection)\n        String insertSQL = \"INSERT INTO users (name, email, age) VALUES (?, ?, ?)\";\n        \n        try (Connection conn = DriverManager.getConnection(url, username, password);\n             PreparedStatement pstmt = conn.prepareStatement(insertSQL)) {\n            \n            // Insert User 1\n            pstmt.setString(1, \"John Doe\");\n            pstmt.setString(2, \"john@example.com\");\n            pstmt.setInt(3, 30);\n            int rows1 = pstmt.executeUpdate();\n            \n            // Insert User 2\n            pstmt.setString(1, \"Jane Smith\");\n            pstmt.setString(2, \"jane@example.com\");\n            pstmt.setInt(3, 25);\n            int rows2 = pstmt.executeUpdate();\n            \n            System.out.println(\"✅ Inserted \" + (rows1 + rows2) + \" rows successfully!\");\n            \n        } catch (SQLException e) {\n            System.err.println(\"❌ Error inserting data!\");\n            e.printStackTrace();\n        }\n \n   }\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inserting Data \n\nimport java.sql.*;\n\npublic class InsertDataExample {\n    public static void main(String[] args) {\n        String url = \"jdbc:mysql://localhost:3306/testdb\";\n        String username = \"root\";\n        String password = \"your_password\";\n        \n        // Using PreparedStatement (recommended - prevents SQL injection)\n        String insertSQL = \"INSERT INTO users (name, email, age) VALUES (?, ?, ?)\";\n        \n        try (Connection conn = DriverManager.getConnection(url, username, password);\n             PreparedStatement pstmt = conn.prepareStatement(insertSQL)) {\n            \n            // Insert User 1\n            pstmt.setString(1, \"John Doe\");\n            pstmt.setString(2, \"john@example.com\");\n            pstmt.setInt(3, 30);\n            int rows1 = pstmt.executeUpdate();\n            \n            // Insert User 2\n            pstmt.setString(1, \"Jane Smith\");\n            pstmt.setString(2, \"jane@example.com\");\n            pstmt.setInt(3, 25);\n            int rows2 = pstmt.executeUpdate();\n            \n            System.out.println(\"✅ Inserted \" + (rows1 + rows2) + \" rows successfully!\");\n            \n        } catch (SQLException e) {\n            System.err.println(\"❌ Error inserting data!\");\n            e.printStackTrace();\n        }\n \n   }\n}",
      "autoResize": true,
      "lineHeight": 1.25
