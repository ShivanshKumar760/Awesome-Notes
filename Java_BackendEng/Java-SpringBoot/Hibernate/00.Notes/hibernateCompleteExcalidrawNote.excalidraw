    {
      "id": "RWiD8JLhHH8BcKTRB46v1",
      "type": "text",
      "x": -404.4933735516662,
      "y": 55913.95696601646,
      "width": 154,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
