    {
      "id": "qAy_flpS_bEF7l5kOBLHD",
      "type": "text",
      "x": 589.0713500976562,
      "y": 2817.3572387695312,
      "width": 671,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFM",
      "roundness": null,
      "seed": 284826494,
      "version": 54,
      "versionNonce": 1528101410,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762085883970,
      "link": null,
      "locked": false,
      "text": "JDBC is NOT a library - it's an API (specification/interface)\nLet me clarify:\nWhat JDBC Actually Is:\nJDBC = Java Database Connectivity API\n\nIt's a specification (a set of rules/interfaces)\nIt's part of Java SE (comes with Java)\nIt defines how Java should talk to databases\nIt's a collection of interfaces in the java.sql package",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JDBC is NOT a library - it's an API (specification/interface)\nLet me clarify:\nWhat JDBC Actually Is:\nJDBC = Java Database Connectivity API\n\nIt's a specification (a set of rules/interfaces)\nIt's part of Java SE (comes with Java)\nIt defines how Java should talk to databases\nIt's a collection of interfaces in the java.sql package",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8-Lj-woMFSoI6cyVueGAp",
      "type": "text",
      "x": 593.78564453125,
      "y": 3084.9285278320312,
      "width": 473,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFS",
      "roundness": null,
      "seed": 349675134,
      "version": 52,
      "versionNonce": 946014114,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762085979153,
      "link": null,
      "locked": false,
      "text": "// These are JDBC interfaces (part of Java)\nimport java.sql.Connection;\nimport java.sql.Statement;\nimport java.sql.ResultSet;\nimport java.sql.DriverManager;",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// These are JDBC interfaces (part of Java)\nimport java.sql.Connection;\nimport java.sql.Statement;\nimport java.sql.ResultSet;\nimport java.sql.DriverManager;",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
