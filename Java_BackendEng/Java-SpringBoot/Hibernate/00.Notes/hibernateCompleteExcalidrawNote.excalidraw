      "boundElements": [],
      "updated": 1762629984512,
      "link": null,
      "locked": false,
      "text": "session.find() in Hibernate\nDefinition\nsession.find() is a JPA standard method used to retrieve an entity\nfrom the database by its primary key (ID). It's the modern,\nrecommended way in Hibernate 6+.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "session.find() in Hibernate\nDefinition\nsession.find() is a JPA standard method used to retrieve an entity from the database by its primary key (ID). It's the modern, recommended way in Hibernate 6+.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "r6ai26q4zG-E5r243F9cS",
      "type": "text",
      "x": -488.53120012511243,
      "y": 38086.273133527844,
      "width": 102.20977288319204,
      "height": 38.71582306181518,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJ6",
      "roundness": null,
      "seed": 1598704249,
      "version": 67,
      "versionNonce": 940732663,
