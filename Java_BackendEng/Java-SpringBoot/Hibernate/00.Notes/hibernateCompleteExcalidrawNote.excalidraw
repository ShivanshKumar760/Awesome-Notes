      "text": "package org.example;\n\nimport jakarta.persistence.Entity;\nimport jakarta.persistence.Id;\nimport jakarta.persistence.ManyToMany;\n\nimport java.util.List;\n\n@Entity\npublic class Societies {\n    @Id\n    private  int sid;\n    private  String s_name;\n    @ManyToMany\n    private List<Members> members;\n\n    public int getSid() {\n        return sid;\n    }\n\n    public void setSid(int sid) {\n        this.sid = sid;\n    }\n\n    public String getS_name() {\n        return s_name;\n    }\n\n    public void setS_name(String s_name) {\n        this.s_name = s_name;\n    }\n\n    public List<Members> getMembers() {\n        return members;\n    }\n\n    public void setMembers(List<Members> members) {\n        this.members = members;\n    }\n}",
      "fontSize": 20.712703172848602,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "package org.example;\n\nimport jakarta.persistence.Entity;\nimport jakarta.persistence.Id;\nimport jakarta.persistence.ManyToMany;\n\nimport java.util.List;\n\n@Entity\npublic class Societies {\n    @Id\n    private  int sid;\n    private  String s_name;\n    @ManyToMany\n    private List<Members> members;\n\n    public int getSid() {\n        return sid;\n    }\n\n    public void setSid(int sid) {\n        this.sid = sid;\n    }\n\n    public String getS_name() {\n        return s_name;\n    }\n\n    public void setS_name(String s_name) {\n        this.s_name = s_name;\n    }\n\n    public List<Members> getMembers() {\n        return members;\n    }\n\n    public void setMembers(List<Members> members) {\n        this.members = members;\n    }\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
