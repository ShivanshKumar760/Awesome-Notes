      "updated": 1762612214169,
      "link": null,
      "locked": false,
      "text": "<dependencies>\n        <dependency>\n            <groupId>org.postgresql</groupId>\n            <artifactId>postgresql</artifactId>\n            <version>42.7.8</version>\n        </dependency>\n\n        <dependency>\n            <groupId>org.hibernate.orm</groupId>\n            <artifactId>hibernate-core</artifactId>\n            <version>7.1.5.Final</version>\n        </dependency>\n\n        <dependency>\n            <groupId>org.springframework</groupId>\n            <artifactId>spring-jdbc</artifactId>\n            <version>6.2.12</version>\n        </dependency>\n    </dependencies>",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<dependencies>\n        <dependency>\n            <groupId>org.postgresql</groupId>\n            <artifactId>postgresql</artifactId>\n            <version>42.7.8</version>\n        </dependency>\n\n        <dependency>\n            <groupId>org.hibernate.orm</groupId>\n            <artifactId>hibernate-core</artifactId>\n            <version>7.1.5.Final</version>\n        </dependency>\n\n        <dependency>\n            <groupId>org.springframework</groupId>\n            <artifactId>spring-jdbc</artifactId>\n            <version>6.2.12</version>\n        </dependency>\n    </dependencies>",
      "autoResize": true,
      "lineHeight": 1.25
