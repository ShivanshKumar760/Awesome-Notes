      "index": "bKB",
      "roundness": null,
      "seed": 720015969,
      "version": 364,
      "versionNonce": 486587617,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763201771866,
      "link": null,
      "locked": false,
      "text": "The perfect example of one to  one relationship is a person can have \nonly one unique passport number or aadhar number ,that is a passport \nwith same number cannot be issued to two or more person and a person\ncan also do not have more than two or more passport/aadhar number",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The perfect example of one to  one relationship is a person can have \nonly one unique passport number or aadhar number ,that is a passport \nwith same number cannot be issued to two or more person and a person\ncan also do not have more than two or more passport/aadhar number",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yqw1hFL1TbXIB7Jyu1rU0",
