    {
      "id": "ySMGDOAsLU_DzoYfIRYvG",
      "type": "text",
      "x": -270.97920763222874,
      "y": 19154.12587995339,
      "width": 530.1550199002598,
      "height": 372.422947863819,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bG5",
      "roundness": null,
      "seed": 1568339161,
      "version": 75,
      "versionNonce": 89829047,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762612953513,
      "link": null,
      "locked": false,
      "text": "Configuration config = new Configuration();\nProperties props = new Properties();\n\nprops.put(Environment.DRIVER, \"org.postgresql.Driver\");\nprops.put(Environment.URL,\n\"jdbc:postgresql://localhost:5432/mydb\");\nprops.put(Environment.USER, \"username\");\nprops.put(Environment.PASS, \"password\");\nprops.put(Environment.DIALECT,\n\"org.hibernate.dialect.PostgreSQLDialect\");\nprops.put(Environment.SHOW_SQL, \"true\");\nprops.put(Environment.HBM2DDL_AUTO, \"update\");\n\nconfig.setProperties(props);\nconfig.addAnnotatedClass(User.class);\n\nSessionFactory sf = config.buildSessionFactory();",
      "fontSize": 17.52578578182676,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Configuration config = new Configuration();\nProperties props = new Properties();\n\nprops.put(Environment.DRIVER, \"org.postgresql.Driver\");\nprops.put(Environment.URL, \"jdbc:postgresql://localhost:5432/mydb\");\nprops.put(Environment.USER, \"username\");\nprops.put(Environment.PASS, \"password\");\nprops.put(Environment.DIALECT, \"org.hibernate.dialect.PostgreSQLDialect\");\nprops.put(Environment.SHOW_SQL, \"true\");\nprops.put(Environment.HBM2DDL_AUTO, \"update\");\n\nconfig.setProperties(props);\nconfig.addAnnotatedClass(User.class);\n\nSessionFactory sf = config.buildSessionFactory();",
      "autoResize": false,
      "lineHeight": 1.25
    },
