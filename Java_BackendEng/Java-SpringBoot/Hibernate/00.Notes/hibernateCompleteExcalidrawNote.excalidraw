    {
      "id": "sGeKT3pBaHu3U4-1dHcH0",
      "type": "text",
      "x": 588.76953125,
      "y": 549.2142944335938,
      "width": 726,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFH",
      "roundness": null,
      "seed": 852995838,
      "version": 69,
      "versionNonce": 2081368254,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762085753088,
      "link": null,
      "locked": false,
      "text": "Why Do We Need JDBC?\nWithout JDBC:\n\n->Every database has its own way of communication\n->You'd need to learn different APIs for MySQL, Oracle, PostgreSQL\n->Code would not be portable\n\nWith JDBC:\n\n✅ Standard API: Same code works with different databases\n✅ Database Independence: Switch databases easily\n✅ Easy Integration: Connect Java apps to any database\n✅ Powerful: Execute SQL queries, stored procedures, transactions",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why Do We Need JDBC?\nWithout JDBC:\n\n->Every database has its own way of communication\n->You'd need to learn different APIs for MySQL, Oracle, PostgreSQL\n->Code would not be portable\n\nWith JDBC:\n\n✅ Standard API: Same code works with different databases\n✅ Database Independence: Switch databases easily\n✅ Easy Integration: Connect Java apps to any database\n✅ Powerful: Execute SQL queries, stored procedures, transactions",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "akNNe1zQOHWn1gTivqZvy",
      "type": "text",
      "x": 575.0753479003906,
      "y": 1001.857177734375,
      "width": 428.9921875,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFI",
      "roundness": null,
      "seed": 374122914,
      "version": 61,
      "versionNonce": 1054210174,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762085797838,
      "link": null,
      "locked": false,
      "text": "┌─────────────────────────────────────┐\n│      Java Application               │\n│    (Your Java Code)                 │\n└──────────────┬──────────────────────┘\n               │\n               ↓\n┌─────────────────────────────────────┐\n│         JDBC API                    │\n│  (java.sql.* package)               │\n└──────────────┬──────────────────────┘\n               │\n               ↓\n┌─────────────────────────────────────┐\n│      JDBC Driver Manager            │\n│  (Manages database drivers)         │\n└──────────────┬──────────────────────┘\n               │\n               ↓\n┌─────────────────────────────────────┐\n│       JDBC Driver                   │\n│  (MySQL Connector, Oracle Driver)   │\n└──────────────┬──────────────────────┘\n               │\n               ↓\n┌─────────────────────────────────────┐\n│          Database                   │\n│   (MySQL, PostgreSQL, Oracle)       │\n└─────────────────────────────────────┘",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "┌─────────────────────────────────────┐\n│      Java Application               │\n│    (Your Java Code)                 │\n└──────────────┬──────────────────────┘\n               │\n               ↓\n┌─────────────────────────────────────┐\n│         JDBC API                    │\n│  (java.sql.* package)               │\n└──────────────┬──────────────────────┘\n               │\n               ↓\n┌─────────────────────────────────────┐\n│      JDBC Driver Manager            │\n│  (Manages database drivers)         │\n└──────────────┬──────────────────────┘\n               │\n               ↓\n┌─────────────────────────────────────┐\n│       JDBC Driver                   │\n│  (MySQL Connector, Oracle Driver)   │\n└──────────────┬──────────────────────┘\n               │\n               ↓\n┌─────────────────────────────────────┐\n│          Database                   │\n│   (MySQL, PostgreSQL, Oracle)       │\n└─────────────────────────────────────┘",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vjsN5Qx-RPCqpK1yufbMX",
      "type": "text",
