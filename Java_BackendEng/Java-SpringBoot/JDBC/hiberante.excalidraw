      "boundElements": null,
      "updated": 1762615659206,
      "link": null,
      "locked": false,
      "text": "This is our configuration file\n1.Specify the postgres sql driver\n2.connection url\n3.username\n4.password\n\n\n5.dialect of sql cause we have \ndifferent sql language and each \nhave a slight change in there\nsyntax\n\n6.update property so that if \na row exist it update that row instead\nof duplicating it or if a table exist\nit update table ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is our configuration file\n1.Specify the postgres sql driver\n2.connection url\n3.username\n4.password\n\n\n5.dialect of sql cause we have \ndifferent sql language and each \nhave a slight change in there\nsyntax\n\n6.update property so that if \na row exist it update that row instead\nof duplicating it or if a table exist\nit update table ",
      "autoResize": true,
      "lineHeight": 1.25
    },
