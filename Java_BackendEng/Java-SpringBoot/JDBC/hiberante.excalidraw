    {
      "id": "wp7o9C9_Rkvg37K23Fu25",
      "type": "text",
      "x": -429.49675751006566,
      "y": 24394.24728407642,
      "width": 594,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHT",
      "roundness": null,
      "seed": 1351728823,
      "version": 26,
      "versionNonce": 1352057369,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1762614585525,
      "link": null,
      "locked": false,
      "text": "// Get SessionFactory (reuse this)\nSessionFactory sf = HibernateUtil.getSessionFactory();\n\n// Create Sessions\nSession session1 = sf.openSession();\nSession session2 = sf.openSession();\n\n// Close on app shutdown\nsf.close();",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Get SessionFactory (reuse this)\nSessionFactory sf = HibernateUtil.getSessionFactory();\n\n// Create Sessions\nSession session1 = sf.openSession();\nSession session2 = sf.openSession();\n\n// Close on app shutdown\nsf.close();",
      "autoResize": true,
      "lineHeight": 1.25
    },
