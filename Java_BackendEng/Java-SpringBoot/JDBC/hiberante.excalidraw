      "text": "Example 5: UPDATE Data\njava\n\nimport java.sql.*;\n\npublic class UpdateDataExample {\n    public static void main(String[] args) {\n        String url = \"jdbc:mysql://localhost:3306/testdb\";\n        String username = \"root\";\n        String password = \"your_password\";\n        \n        String updateSQL = \"UPDATE users SET age = ? WHERE email = ?\";\n        \n        try (Connection conn = DriverManager.getConnection(url, username, password);\n             PreparedStatement pstmt = conn.prepareStatement(updateSQL)) {\n            \n            pstmt.setInt(1, 31);  // New age\n            pstmt.setString(2, \"john@example.com\");\n            \n            int rowsUpdated = pstmt.executeUpdate();\n            \n            if (rowsUpdated > 0) {\n                System.out.println(\"✅ User updated successfully! Rows affected: \" +\nrowsUpdated);\n            } else {\n                System.out.println(\"⚠️ No user found with that email.\");\n            }\n            \n        } catch (SQLException e) {\n            System.err.println(\"❌ Error updating data!\");\n            e.printStackTrace();\n        }\n    }",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example 5: UPDATE Data\njava\n\nimport java.sql.*;\n\npublic class UpdateDataExample {\n    public static void main(String[] args) {\n        String url = \"jdbc:mysql://localhost:3306/testdb\";\n        String username = \"root\";\n        String password = \"your_password\";\n        \n        String updateSQL = \"UPDATE users SET age = ? WHERE email = ?\";\n        \n        try (Connection conn = DriverManager.getConnection(url, username, password);\n             PreparedStatement pstmt = conn.prepareStatement(updateSQL)) {\n            \n            pstmt.setInt(1, 31);  // New age\n            pstmt.setString(2, \"john@example.com\");\n            \n            int rowsUpdated = pstmt.executeUpdate();\n            \n            if (rowsUpdated > 0) {\n                System.out.println(\"✅ User updated successfully! Rows affected: \" + rowsUpdated);\n            } else {\n                System.out.println(\"⚠️ No user found with that email.\");\n            }\n            \n        } catch (SQLException e) {\n            System.err.println(\"❌ Error updating data!\");\n            e.printStackTrace();\n        }\n    }",
      "autoResize": false,
      "lineHeight": 1.25
