      "text": "Example 4: SELECT Data (Read)\njava\n\nimport java.sql.*;\n\npublic class SelectDataExample {\n    public static void main(String[] args) {\n        String url = \"jdbc:mysql://localhost:3306/testdb\";\n        String username = \"root\";\n        String password = \"your_password\";\n        \n        String selectSQL = \"SELECT id, name, email, age FROM users\";\n        \n        try (Connection conn = DriverManager.getConnection(url, username, password);\n             Statement stmt = conn.createStatement();\n             ResultSet rs = stmt.executeQuery(selectSQL)) {\n            \n            System.out.println(\"📋 Users List:\");\n            System.out.println(\"─\".repeat(60));\n            \n            while (rs.next()) {\n                int id = rs.getInt(\"id\");\n                String name = rs.getString(\"name\");\n                String email = rs.getString(\"email\");\n                int age = rs.getInt(\"age\");\n                \n                System.out.printf(\"ID: %d | Name: %-15s | Email: %-20s | Age: %d%n\",\n                                  id, name, email, age);\n            }\n            \n            System.out.println(\"─\".repeat(60));\n            \n        } catch (SQLException e) {\n            System.err.println(\"❌ Error fetching data!\");\n            e.printStackTrace();\n        }\n    }\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example 4: SELECT Data (Read)\njava\n\nimport java.sql.*;\n\npublic class SelectDataExample {\n    public static void main(String[] args) {\n        String url = \"jdbc:mysql://localhost:3306/testdb\";\n        String username = \"root\";\n        String password = \"your_password\";\n        \n        String selectSQL = \"SELECT id, name, email, age FROM users\";\n        \n        try (Connection conn = DriverManager.getConnection(url, username, password);\n             Statement stmt = conn.createStatement();\n             ResultSet rs = stmt.executeQuery(selectSQL)) {\n            \n            System.out.println(\"📋 Users List:\");\n            System.out.println(\"─\".repeat(60));\n            \n            while (rs.next()) {\n                int id = rs.getInt(\"id\");\n                String name = rs.getString(\"name\");\n                String email = rs.getString(\"email\");\n                int age = rs.getInt(\"age\");\n                \n                System.out.printf(\"ID: %d | Name: %-15s | Email: %-20s | Age: %d%n\",\n                                  id, name, email, age);\n            }\n            \n            System.out.println(\"─\".repeat(60));\n            \n        } catch (SQLException e) {\n            System.err.println(\"❌ Error fetching data!\");\n            e.printStackTrace();\n        }\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
