    {
      "id": "QtuRRl3H-_NoN5cj5X9Tv",
      "type": "text",
      "x": -479.5693458746765,
      "y": 38978.88603060781,
      "width": 671,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJC",
      "roundness": null,
      "seed": 1829282967,
      "version": 56,
      "versionNonce": 296823929,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1762630089961,
      "link": null,
      "locked": false,
      "text": "Example 2: Find with Different ID Types\njava// Long ID\nUser user = session.find(User.class, 1L);\n\n// Integer ID\nProduct product = session.find(Product.class, 123);\n\n// String ID\nOrder order = session.find(Order.class, \"ORD-2024-001\");\n\n// UUID ID\nimport java.util.UUID;\nCustomer customer = session.find(Customer.class, \n    UUID.fromString(\"123e4567-e89b-12d3-a456-426614174000\"));",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example 2: Find with Different ID Types\njava// Long ID\nUser user = session.find(User.class, 1L);\n\n// Integer ID\nProduct product = session.find(Product.class, 123);\n\n// String ID\nOrder order = session.find(Order.class, \"ORD-2024-001\");\n\n// UUID ID\nimport java.util.UUID;\nCustomer customer = session.find(Customer.class, \n    UUID.fromString(\"123e4567-e89b-12d3-a456-426614174000\"));",
      "autoResize": true,
      "lineHeight": 1.25
    },
